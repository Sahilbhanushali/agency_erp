{
  "name": "itsmedezinoagencyerp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build --turbopack",
    "dev": "next dev --turbopack",
    "lint": "next lint",
    "start": "next start -p $PORT",
    "db:seed": "node prisma/seed.mjs",
    "db:seed:dev": "node --env-file=.env prisma/seed-dev.mjs",
    "test:workflow": "node --test lib/posts/workflow-rules.test.mjs",
    "test:workflow:api": "node --env-file=.env --test --test-concurrency=1 scripts/test-post-workflow.mjs",
    "test:presentation": "node --test lib/posts/presentation-preview.test.ts",
    "test:credentials": "node --test lib/credentials/vault.test.ts",
    "test:ip": "node --test lib/rate-limit.test.ts",
    "credentials:reseal": "node --env-file=.env scripts/reseal-credentials.ts",
    "test:features:api": "node --env-file=.env --test --test-concurrency=1 scripts/test-feature-batch.mjs",
    "db:push": "prisma db push",
    "check:finance": "tsc lib/finance.ts lib/finance.check.ts --outDir node_modules/.cache/finance-check --module commonjs --target es2022 --esModuleInterop --strict && node node_modules/.cache/finance-check/finance.check.js",
    "db:fresh": "prisma db push --force-reset && node prisma/seed.mjs",
    "build:vps": "NODE_OPTIONS=--max-old-space-size=1024 next build",
    "build:webpack": "next build",
    "check:instagram": "tsc lib/instagram/token-vault.ts lib/instagram/token-vault.check.ts lib/instagram/media-rules.ts lib/instagram/media-rules.check.ts --outDir node_modules/.cache/instagram-check --module commonjs --target es2022 --esModuleInterop --strict && node node_modules/.cache/instagram-check/token-vault.check.js && node node_modules/.cache/instagram-check/media-rules.check.js",
    "check:chat": "tsc lib/chat/file-rules.ts lib/chat/storage.ts lib/chat/file-rules.check.ts --outDir node_modules/.cache/chat-check --module commonjs --target es2022 --esModuleInterop --strict --skipLibCheck --types node && node node_modules/.cache/chat-check/file-rules.check.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-avatar": "latest",
    "@radix-ui/react-checkbox": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-dropdown-menu": "latest",
    "@radix-ui/react-label": "latest",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-select": "latest",
    "@radix-ui/react-separator": "latest",
    "@radix-ui/react-slot": "latest",
    "@radix-ui/react-switch": "latest",
    "@radix-ui/react-tabs": "latest",
    "@radix-ui/react-toast": "1.2.4",
    "@radix-ui/react-toggle": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.6",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "crypto": "latest",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "geist": "latest",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.2",
    "lucide-react": "^0.454.0",
    "next": "^15.5.2",
    "next-auth": "latest",
    "next-themes": "latest",
    "node-cron": "^4.2.1",
    "nodemailer": "^10.0.16",
    "postcss": "^8.5.29",
    "react": "^19.1.1",
    "react-day-picker": "9.8.0",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.60.0",
    "react-hot-toast": "^2.6.0",
    "sonner": "latest",
    "swr": "^2.3.6",
    "tailwind-merge": "^2.5.5",
    "uuid": "^14.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.9",
    "@types/crypto-js": "^4.2.2",
    "@types/file-saver": "^2.0.7",
    "@types/jszip": "^3.4.0",
    "@types/luxon": "^3.7.2",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.9",
    "tw-animate-css": "1.3.3",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "postcss": "^8.5.29",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@tailwindcss/oxide@4.1.13": true,
    "core-js": false
  }
}
