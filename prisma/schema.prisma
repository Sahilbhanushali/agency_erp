  title           String
  category        String    @default("OTHER") // IDENTITY, EDUCATION, EMPLOYMENT, BANK_TAX, CONTRACTS, OTHER
  status          String    @default("PENDING") // PENDING, VERIFIED, REJECTED, EXPIRED
