// ---------------------------------------------------------------------------
// Daily todos
//
// What someone plans to do today. Separate from Task: a Task is a unit of work that
// lives until it is finished, while a DailyTodo is a commitment for one date. A task
// due today is mirrored into that day's list (taskId set) so progress is reported in
// one place; anything else the person types is a standalone entry.
// ---------------------------------------------------------------------------

enum TodoStatus {
  PENDING
  IN_PROGRESS
  BLOCKED
  DONE
  CARRIED_OVER
}

model DailyTodo {
  id     String   @id @default(cuid())
  userId Int
  /// The day this belongs to, at midnight. Date-only so "today" is unambiguous.
  date   DateTime

  title  String
  notes  String? @db.Text

  status   TodoStatus @default(PENDING)
  /// 0-100. Kept alongside status because "in progress" alone does not tell a manager
  /// whether something is nearly done or barely started.
  progress Int        @default(0)
  /// What is stopping this, in the person's own words. The EOD report leads with these.
  blocker  String?    @db.Text

  /// Set when this entry mirrors a Task due today.
  taskId String?

  position    Int       @default(0)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User  @relation("UserTodos", fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  /// One entry per task per person per day. MySQL allows repeated NULLs, so manually
  /// added todos are not constrained by this.
  @@unique([userId, date, taskId])
  @@index([userId, date])
  @@index([date])
  @@map("daily_todos")
}


// ---------------------------------------------------------------------------
// Scheduled jobs
//
// The schedule used to live in scripts/cron-job.js, so changing when a report went out
// meant editing code and restarting PM2. These rows are the source of truth instead:
// the cron supervisor re-reads them every minute, so an administrator can change a
// time, pick different recipients, or switch a job off, and it takes effect without a
// deploy.
//
// `key` is fixed in code (it maps to an endpoint); everything else is configuration.
// ---------------------------------------------------------------------------

enum JobRecipientMode {
  /// Work out recipients from the data — a person's reportsTo manager, falling back to
  /// whoever holds the relevant permission.
  AUTO
  /// Send only to the people explicitly chosen in the admin screen.
  EXPLICIT
  /// Both.
  BOTH
}

model ScheduledJob {
  id  String @id @default(cuid())
  /// Stable identifier matching a known endpoint, e.g. "eod-todo-report".
  key String @unique

  label       String
  description String? @db.Text

  /// Standard five-field cron expression, validated before it is saved.
  cronExpression String
  timezone       String  @default("Asia/Kolkata")
  isEnabled      Boolean @default(true)

  recipientMode   JobRecipientMode @default(AUTO)
  /// User ids chosen in the admin screen, when the mode includes EXPLICIT.
  recipientUserIds Json?
  /// Addresses that are not app users, e.g. a shared inbox.
  recipientEmails  Json?

  /// Set when an administrator presses "Run now". The scheduler picks it up on its next
  /// poll and clears it, so a manual run takes exactly the same path as a scheduled one.
  runRequestedAt DateTime?

  lastRunAt    DateTime?
  lastStatus   String?   // "ok" | "error"
  lastMessage  String?   @db.Text
  updatedById  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  updatedBy User?    @relation("JobsUpdated", fields: [updatedById], references: [id], onDelete: SetNull)
  runs      JobRun[]

  @@map("scheduled_jobs")
}

/// A short history per job, so "did the report go out?" is answerable.
model JobRun {
  id         String   @id @default(cuid())
  jobId      String
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  ok         Boolean  @default(false)
  message    String?  @db.Text
  /// "schedule" or "manual" — who asked for this run.
  trigger    String   @default("schedule")

  job ScheduledJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, startedAt])
  @@map("job_runs")
}

/**
 * How a payslip PDF is branded and which blocks it shows.
 *
 * The generator used to hardcode every one of these, including a placeholder company
 * address that printed on real payslips sent to employees. One template is the default
 * and is used whenever a payslip is rendered or emailed.
 */
model PayslipTemplate {
  id          String  @id @default(cuid())
  name        String  @unique
  description String? @db.Text

  companyName    String
  companyAddress String? @db.Text
  /// Served from public/uploads; drawn top-left on the PDF.
  logoUrl        String?
  signatoryText  String  @default("Authorized Signatory")
  footerNote     String? @db.Text

  showBankDetails   Boolean @default(true)
  showPan           Boolean @default(true)
  showLeaveSummary  Boolean @default(true)
  showEmployerCost  Boolean @default(false)
  showAmountInWords Boolean @default(true)

  /**
   * Body layout: an ordered [{ key, visible }] list naming which sections the payslip
   * prints and in what order. Null means the built-in order, so templates created
   * before this existed keep rendering exactly as they did.
   */
  sections    Json?
  /// Hex colour for the header bar and section accents.
  accentColor String  @default("#0F172A")
  /// A4 or LETTER.
  paperSize   String  @default("A4")

  /// Exactly one template is the default; the API keeps that true.
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  payrollRuns PayrollRun[] @relation("RunPayslipTemplate")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDefault])
  @@map("payslip_templates")
}
