enum ContractType {
  RETAINER
  FIXED_SOW
  NDA
  MASTER_SERVICES_AGREEMENT
  ONE_TIME
  CUSTOM
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRING_SOON
  EXPIRED
  TERMINATED
  RENEWED
}

model Contract {
  id               String         @id @default(cuid())
  clientId         String
  projectId        String?
  createdById      Int?

  contractNumber   String?        // e.g. CNT-2026-0001
  title            String
  type             ContractType   @default(RETAINER)
  status           ContractStatus @default(ACTIVE)

  value            Decimal        @default(0) @db.Decimal(14, 2)
  currency         String         @default("INR")
  billingCycle     String         @default("MONTHLY") // MONTHLY, QUARTERLY, ANNUALLY, ONE_TIME

