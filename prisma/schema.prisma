// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PostType {
  PHOTO
  REEL
  STORY
  CAROUSEL
  CUSTOM
  BLOG
  UNKNOWN
}

enum PostStatus {
  DRAFT
  SUBMITTED
  APPROVED
  C_APPROVED
  REJECTED
  SCHEDULED
  POSTED
  RESUBMITTED
  NEEDS_MINOR_CHANGE
}

enum Platform {
  INSTAGRAM
  FACEBOOK
  TWITTER
  LINKEDIN
  THREADS
  YOUTUBE
  IGTV
  GMB
  PINTEREST
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  SCHEDULE
  PUBLISH
  SUBMITTED
}

enum CommentType {
  DESIGN
  CONTENT
  DESIGNER_HEAD
}

enum ActivityType {
  POST_CREATED
  POST_ASSIGNED
  POST_SCHEDULED
  POST_POSTED
  DESIGN_STARTED
  DESIGN_UPLOADED
  DESIGN_SUBMITTED
  DESIGN_RESUBMITTED
  DESIGN_APPROVED
  DESIGN_REJECTED
  DESIGNER_HEAD_REJECTED
  DESIGNER_HEAD_APPROVED
  DESIGNER_HEAD_NEEDS_MINOR_CHANGE
  CONTENT_SUBMITTED
  CONTENT_RESUBMITTED
  CONTENT_NEEDS_REVISION
  CONTENT_APPROVED
  CONTENT_REJECTED
  CONTENT_NEEDS_MINOR_CHANGE
  DESIGN_NEEDS_MINOR_CHANGE
  COMMENT_ADDED
  ASSET_UPLOADED
  LOGIN
  LOGOUT
  PROJECT_CREATED
  PROJECT_UPDATED
}

enum WorkflowStage {
  CONTENT_REVIEW // Content being reviewed by Social Media Manager
  DESIGN_PENDING // Waiting for designer to work on it
  DESIGN_IN_PROGRESS // Designer is working
  DESIGN_REVIEW // Design being reviewed by Team Lead
  BOTH_APPROVED // Both content and design approved
  FINAL_REVIEW // Final review before scheduling
  READY_TO_SCHEDULE // Ready for scheduling
  SCHEDULED // Scheduled
  PUBLISHED // Published
}

enum ContentStatus {
  DRAFT
  SUBMITTED
  PENDING_REVIEW
  NEEDS_REVISION
  APPROVED
  REJECTED
  RESUBMITTED
  NEEDS_MINOR_CHANGE
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  roleId    Int? // New foreign key to Role
  avatar    String?
  password  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  role             Role?          @relation(fields: [roleId], references: [id])
  clientProjects   Project[]      @relation("ClientProjects")
  assignedProjects Project[]      @relation("AssignedProjects")
  smtpDetails      SmtpDetails?   @relation("UserToSmtpDetails")
  createdPosts     Post[]         @relation("CreatedPosts")
  assignedPosts    Post[]         @relation("AssignedPosts")
  comments         Comment[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  sentInvites      Invite[]
  uploadedAssets   Asset[]
  taskLogs         TaskLog[] // Added relation to TaskLog

  // New activity tracking relations
  activities          UserActivity[]       @relation("UserActivities")
  flowSubmissions     ApprovalFlow[]       @relation("FlowSubmissions")
  flowReviews         ApprovalFlow[]       @relation("FlowReviews")
  flowAssignments     ApprovalFlow[]       @relation("FlowAssignments")
  performedActions    ApprovalHistory[]    @relation("PerformedActions")
  assignments         PostAssignment[]     @relation("UserAssignments")
  metrics             UserMetrics[]        @relation("UserMetrics")
  approvalAttachments ApprovalAttachment[]

  // New relation for multiple assignments
  assignedToMultiplePosts Post[] @relation("PostAssignees")
  createdExportLinks  ExportLink[] @relation("CreatedExportLinks")
  createdQuotations   Quotation[]  @relation("CreatedQuotations")
  createdInvoices     Invoice[]    @relation("CreatedInvoices")
  recordedPayments    Payment[]    @relation("RecordedPayments")

  // HR & Employee Details
  joiningDate          DateTime?
  designation          String?
  department           String?
  currentSalary        Decimal?             @db.Decimal(12, 2)
  salaryFrequency      String?              @default("MONTHLY")
  employmentType       String?              @default("FULL_TIME")
  phone                String?
  personalEmail        String?
  address              String?              @db.Text
  panNumber            String?
  aadhaarNumber        String?
  bankName             String?
  bankAccountNumber    String?
  bankIfsc             String?
  emergencyContactName String?
  emergencyContactPhone String?
  emergencyContactRelation String?
  offerLetterUrl       String?
  documents            UserDocument[]
  assignedLeads        Lead[]               @relation("AssignedLeads")
  createdLeads         Lead[]               @relation("CreatedLeads")

  @@map("users")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  projects    Project[]
  credentials Credential[]
  exportLinks ExportLink[]
  quotations  Quotation[]
  invoices    Invoice[]

  @@map("clients")
}

model Project {
  id          String    @id @default(cuid())
  name        String
  description String?
  startDate   DateTime
  endDate     DateTime?
  isActive    Boolean   @default(true)
  image       String?
  postTypes   Json? // Add this field to store post type counts (e.g., { "REEL": 5, "POST": 3 })
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Foreign Keys
  clientId  String?
  managerId Int?

  // Relations
  client        Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  manager       User?             @relation("ClientProjects", fields: [managerId], references: [id], onDelete: SetNull)
  assignedUsers User[]            @relation("AssignedProjects")
  posts         Post[]
  strategies    ProjectStrategy[]
  activities    UserActivity[]    @relation("ProjectActivities")
  credentials   Credential[]
  exportLinks   ExportLink[]
  quotations    Quotation[]
  invoices      Invoice[]

  @@map("projects")
}

model ProjectStrategy {
  id        Int   @id @default(autoincrement())
  month     Int?
  year      Int?
  postTypes Json?
  total     Int?

  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, month, year]) // avoid duplicates
  @@map("project_strategies")
}

model Post {
  id                   String        @id @default(cuid())
  title                String
  caption              String?       @db.Text
  type                 PostType
  status               PostStatus    @default(DRAFT) // for design flow
  contentStatus        ContentStatus @default(DRAFT) // for content flow
  designerHeadApproval PostStatus    @default(DRAFT) // for design flow
  scheduledAt          DateTime?
  designDueDate        DateTime?
  scheduledFor         DateTime?
  postedAt             DateTime?
  approvedAt           DateTime?
  rejectedAt           DateTime?
  writeUp              String?       @db.Text
  notes                String?       @db.Text
  referenceUrl         String?       @db.Text
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  festivalId           Int? // Added to reference Festival
  keyword              String?       @db.Text
  customData           Json?
  // Foreign Keys
  projectId            String
  createdById          Int?
  assignedToMultiple   Json?
  assignedToId         Int?

  // Design approval tracking
  designApprovedAt   DateTime?
  designRejectedAt   DateTime?
  designApprovedById Int?
  designRejectedById Int?

  // Content approval tracking
  contentApprovedAt   DateTime?
  contentRejectedAt   DateTime?
  contentApprovedById Int?
  contentRejectedById Int?

  // Relations
  project    Project @relation(fields: [projectId], references: [id])
  createdBy  User?   @relation("CreatedPosts", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo User?   @relation("AssignedPosts", fields: [assignedToId], references: [id], onDelete: SetNull)

  festival Festival? @relation("FestivalPosts", fields: [festivalId], references: [id])

  assets    Asset[]
  comments  Comment[]
  platforms PostPlatform[]
  taskLogs  TaskLog[] // Added relation to TaskLog

  // New relations
  approvalFlows ApprovalFlow[]   @relation("PostApprovalFlows")
  assignments   PostAssignment[] @relation("PostAssignments")

  // New relation for multiple assignees
  assignedUsers User[] @relation("PostAssignees")

  @@map("posts")
}

// Junction table for Post-Platform relationship
model PostPlatform {
  id       String   @id @default(cuid())
  platform Platform

  // Foreign Keys
  postId String

  // Is posted status
  isPosted Boolean @default(false)

  // Relations
  post Post @relation(fields: [postId], references: [id])

  // Ensure a post can't have duplicate platforms
  @@unique([postId, platform])
  @@map("post_platforms")
}

model Asset {
  id          String   @id @default(cuid())
  filename    String
  url         String
  type        String? // image, video, etc.
  size        Int?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  isReference Boolean  @default(false)
  isEdited    Boolean  @default(false)

  // Foreign Keys
  postId       String
  uploadedById Int? // Add this field

  // Relations
  post       Post  @relation(fields: [postId], references: [id])
  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull) // Add this relation

  @@map("assets")
}

model Comment {
  id        String       @id @default(cuid())
  type      CommentType?
  content   String       @db.Text
  createdAt DateTime     @default(now())

  // Foreign Keys
  postId String
  userId Int?
  authorName String?
  authorRole String?

  // Relations
  post Post  @relation(fields: [postId], references: [id])
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("comments")
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  link      String?  @db.Text // Optional link for redirection
  createdAt DateTime @default(now())

  // Foreign Keys
  userId Int

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String   @db.Text
  entityType String // e.g., "Post", "User", "Project"
  entityId   String? // ID of the affected entity
  oldValues  String?  @db.Text // JSON string of old values
  newValues  String?  @db.Text // JSON string of new values
  feedback   String?  @db.Text // New field for feedback
  ipAddress  String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())

  // Foreign Keys
  userId Int?

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_resets")
}

model Invite {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  role      String
  expiresAt DateTime
  createdAt DateTime @default(now())
  invitedBy Int?

  inviter User? @relation(fields: [invitedBy], references: [id], onDelete: SetNull)

  @@map("invites")
}

model Utility {
  id        String   @id @default(cuid())
  name      String
  type      String // PLATFORM, POST_TYPE, etc.
  values    Json // Array of string values
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("utilities")
}

model Festival {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  date        DateTime
  primaryType String   @map("primary_type")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relation back to Post
  posts Post[] @relation("FestivalPosts")

  @@map("festivals")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  // Relations
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           Int      @id @default(autoincrement())
  roleId       Int
  permissionId Int
  createdAt    DateTime @default(now())

  // Relations
  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model SmtpDetails {
  id         Int        @id @default(autoincrement())
  host       String
  port       Int
  username   String
  password   String
  encryption Encryption
  isActive   Boolean    @default(true) // Added
  isVerified Boolean    @default(false) // Added
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  userId     Int        @unique
  user       User       @relation("UserToSmtpDetails", fields: [userId], references: [id])
}

enum Encryption {
  TLS
  SSL
  NONE
}

model TaskLog {
  id        String      @id @default(cuid())
  action    String // Reuse AuditAction enum for consistency
  oldStatus PostStatus? // Optional, for status changes
  newStatus PostStatus? // Optional, for status changes
  oldValues Json? // JSON of old field values (e.g., { "caption": "old text" })
  newValues Json? // JSON of new field values
  feedback  String?     @db.Text // Feedback or notes on the change
  ipAddress String?
  userAgent String?     @db.Text
  createdAt DateTime    @default(now())

  // Foreign Keys
  postId String
  userId Int?

  // Relations
  post Post  @relation(fields: [postId], references: [id])
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("task_logs")
}

model UserActivity {
  id           String       @id @default(cuid())
  activityType ActivityType
  entityType   String // "Post", "Project", "Comment", etc.
  entityId     String? // ID of the related entity
  description  String?      @db.Text // Human-readable description
  metadata     Json? // Additional context
  ipAddress    String?
  userAgent    String?      @db.Text
  createdAt    DateTime     @default(now())

  // Foreign Keys
  userId    Int?
  projectId String?

  // Relations
  user    User?    @relation("UserActivities", fields: [userId], references: [id], onDelete: SetNull)
  project Project? @relation("ProjectActivities", fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([activityType, createdAt])
  @@index([entityId, entityType])
  @@map("user_activities")
}

model ApprovalFlow {
  id              String    @id @default(cuid())
  flowType        String // "DESIGN" or "CONTENT"
  status          String // "PENDING", "APPROVED", "REJECTED", "RESUBMITTED"
  submittedAt     DateTime?
  reviewedAt      DateTime?
  feedback        String?   @db.Text
  submissionCount Int       @default(0)
  version         Int       @default(1) // Track version of submission 

  // Time tracking
  timeToSubmit Int? // Minutes from assignment to submission
  timeToReview Int? // Minutes from submission to review

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign Keys
  postId        String
  submittedById Int? // User who submitted (designer or content writer)
  reviewedById  Int? // User who reviewed (Team Lead or social media manager)
  assignedToId  Int? // Current assignee

  // Relations
  post            Post                 @relation("PostApprovalFlows", fields: [postId], references: [id])
  submittedBy     User?                @relation("FlowSubmissions", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy      User?                @relation("FlowReviews", fields: [reviewedById], references: [id], onDelete: SetNull)
  assignedTo      User?                @relation("FlowAssignments", fields: [assignedToId], references: [id], onDelete: SetNull)
  rejectionReason String?              @db.Text
  attachments     ApprovalAttachment[] // NEW: Support multiple attachments

  history ApprovalHistory[]

  @@index([postId, flowType])
  @@index([submittedById])
  @@index([reviewedById])
  @@index([status])
  @@map("approval_flows")
}

model ApprovalAttachment {
  id         String   @id @default(cuid())
  type       String // "AUDIO", "IMAGE", "DOCUMENT"
  url        String
  filename   String
  size       Int?
  duration   Int? // For audio/video files (in seconds)
  mimeType   String?
  uploadedAt DateTime @default(now())

  // Foreign Key
  approvalFlowId String
  uploadedById   Int?

  // Relations
  approvalFlow ApprovalFlow @relation(fields: [approvalFlowId], references: [id])
  uploadedBy   User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@map("approval_attachments")
}

model ApprovalHistory {
  id         String   @id @default(cuid())
  action     String // "SUBMITTED", "APPROVED", "REJECTED", "RESUBMITTED", "REASSIGNED"
  fromStatus String?
  toStatus   String
  feedback   String?  @db.Text
  version    Int // Version at this point
  metadata   Json? // Store additional data like changed fields
  createdAt  DateTime @default(now())

  // Foreign Keys
  approvalFlowId String
  performedById  Int? // User who performed this action

  // Relations
  approvalFlow ApprovalFlow @relation(fields: [approvalFlowId], references: [id])
  performedBy  User?        @relation("PerformedActions", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([approvalFlowId, createdAt])
  @@index([performedById])
  @@map("approval_history")
}

// USER PERFORMANCE METRICS
model UserMetrics {
  id          String   @id @default(cuid())
  period      String // "daily", "weekly", "monthly"
  periodStart DateTime
  periodEnd   DateTime

  // Design Flow Metrics (for designers)
  designsAssigned         Int    @default(0)
  designsCompleted        Int    @default(0)
  designsSubmitted        Int    @default(0)
  designsResubmitted      Int    @default(0)
  designsApproved         Int    @default(0)
  designsRejected         Int    @default(0)
  designApprovalRate      Float?
  avgDesignResubmissions  Float?
  avgDesignCompletionTime Float? // Hours

  // Content Flow Metrics (for content writers)
  contentsCreated         Int    @default(0)
  contentsSubmitted       Int    @default(0)
  contentsResubmitted     Int    @default(0)
  contentsApproved        Int    @default(0)
  contentsRejected        Int    @default(0)
  contentApprovalRate     Float?
  avgContentResubmissions Float?

  // Review Metrics (for heads/managers)
  reviewsCompleted Int    @default(0)
  approvalsMade    Int    @default(0)
  rejectionsMade   Int    @default(0)
  avgReviewTime    Float? // Hours

  // Overall Metrics
  totalTasks     Int  @default(0)
  tasksCompleted Int  @default(0)
  commentsAdded  Int  @default(0)
  assetsUploaded Int  @default(0)
  activeTime     Int? // Minutes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign Keys
  userId Int

  // Relations
  user User @relation("UserMetrics", fields: [userId], references: [id])

  @@unique([userId, period, periodStart])
  @@index([userId, periodStart])
  @@map("user_metrics")
}

// POST ASSIGNMENTS - Track who is responsible at each stage
model PostAssignment {
  id          String        @id @default(cuid())
  role        String // "DESIGNER", "DESIGNER_HEAD", "CONTENT_WRITER", "SOCIAL_MEDIA_MANAGER"
  stage       WorkflowStage
  status      String // "ACTIVE", "COMPLETED", "SKIPPED"
  assignedAt  DateTime      @default(now())
  completedAt DateTime?

  // Foreign Keys
  postId String
  userId Int?

  // Relations
  post Post  @relation("PostAssignments", fields: [postId], references: [id])
  user User? @relation("UserAssignments", fields: [userId], references: [id], onDelete: SetNull)

  @@index([postId, role])
  @@index([userId, status])
  @@map("post_assignments")
}

// Credentials model for platform logins
model Credential {
  id        String   @id @default(cuid())
  clientId  String
  projectId String
  location  String
  platform  String
  userId    String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    Client   @relation(fields: [clientId], references: [id])
  project   Project  @relation(fields: [projectId], references: [id])

  @@map("credentials")
}

model ExportLink {
  id               String    @id @default(cuid())
  token            String    @unique
  projectId        String?
  clientId         String?
  createdById      Int?
  month            Int?
  year             Int?
  postIds          Json?
  status           String    @default("ACTIVE") // ACTIVE, CONFIRMED, REVOKED, EXPIRED, CHANGES_REQUESTED
  confirmedAt      DateTime?
  confirmedByName  String?
  confirmedByEmail String?
  feedback         String?   @db.Text
  expiresAt        DateTime?
  revokedAt        DateTime?
  passwordHash        String?
  passwordEncrypted   String?   @db.Text
  passwordUpdatedAt   DateTime?
  passwordExpiresAt   DateTime?
  failedAttemptCount  Int       @default(0)
  lockedUntil         DateTime?
  lastAuthenticatedAt DateTime?
  lastEmailSentAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project          Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client           Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy        User?     @relation("CreatedExportLinks", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([clientId])
  @@index([status])
  @@index([token])
  @@map("export_links")
}

model ShootEvent {
  id        String   @id @default(cuid())
  name      String
  location  String?
  date      String
  time      String?
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("shoot_events")
}

// =============================================================================
// FINANCE — billing entities and the documents they issue
// A Company is one of OUR legal entities: the issuer on a quotation or invoice.
// Documents are numbered per company, so two companies can both hold INV-2026-0001.
// =============================================================================

enum TaxType {
  CGST_SGST // intra-state: tax split across CGST and SGST
  IGST // inter-state: single integrated rate
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  UPI
  CASH
  CHEQUE
  CARD
  OTHER
}

model Company {
  id         String  @id @default(cuid())
  name       String
  legalName  String?
  email      String?
  phone      String?
  website    String?
  logo       String?
  letterhead String?
  signature  String?

  // Statutory identifiers (India)
  gstNumber String?
  panNumber String?
  hsnNumber String?

  // Payment instructions printed on documents
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  bankBranch        String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String  @default("India")

  currency String  @default("INR")
  isActive Boolean @default(true)
  notes    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotations Quotation[]
  invoices   Invoice[]

  @@map("companies")
}

model Quotation {
  id          String  @id @default(cuid())
  companyId   String
  clientId    String
  projectId   String?
  createdById Int?

  number String // unique within its company, e.g. QT-2026-0001
  title  String
  status QuotationStatus @default(DRAFT)

  currency        String   @default("INR")
  subtotal        Decimal  @default(0) @db.Decimal(14, 2)
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  taxType         TaxType  @default(CGST_SGST)
  taxPercent      Decimal  @default(18) @db.Decimal(5, 2)
  totalAmount     Decimal  @default(0) @db.Decimal(14, 2)

  validUntil DateTime?
  terms      String?   @db.Text
  notes      String?   @db.Text

  // Public, tokenised view for the client — no login required
  shareToken     String?   @unique
  shareExpiresAt DateTime?

  sentAt      DateTime?
  acceptedAt  DateTime?
  convertedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company   Company         @relation(fields: [companyId], references: [id])
  client    Client          @relation(fields: [clientId], references: [id])
  project   Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User?           @relation("CreatedQuotations", fields: [createdById], references: [id], onDelete: SetNull)
  lineItems QuotationLine[]
  invoice   Invoice?

  @@unique([companyId, number])
  @@index([companyId])
  @@index([clientId])
  @@index([projectId])
  @@index([status])
  @@map("quotations")
}

model QuotationLine {
  id          String  @id @default(cuid())
  quotationId String
  description String  @db.Text
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unit        String?
  unitPrice   Decimal @default(0) @db.Decimal(14, 2)
  position    Int     @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_lines")
}

model Invoice {
  id          String  @id @default(cuid())
  companyId   String
  clientId    String
  projectId   String?
  quotationId String? @unique
  createdById Int?

  number String // unique within its company, e.g. INV-2026-0001
  title  String
  status InvoiceStatus @default(DRAFT)

  currency        String  @default("INR")
  subtotal        Decimal @default(0) @db.Decimal(14, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  taxType         TaxType @default(CGST_SGST)
  taxPercent      Decimal @default(18) @db.Decimal(5, 2)
  totalAmount     Decimal @default(0) @db.Decimal(14, 2)

  issueDate DateTime @default(now())
  dueDate   DateTime?
  terms     String?  @db.Text
  notes     String?  @db.Text

  shareToken     String?   @unique
  shareExpiresAt DateTime?

  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  company   Company       @relation(fields: [companyId], references: [id])
  client    Client        @relation(fields: [clientId], references: [id])
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  quotation Quotation?    @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  createdBy User?         @relation("CreatedInvoices", fields: [createdById], references: [id], onDelete: SetNull)
  lineItems InvoiceLine[]
  payments  Payment[]

  @@unique([companyId, number])
  @@index([companyId])
  @@index([clientId])
  @@index([projectId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  description String  @db.Text
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unit        String?
  unitPrice   Decimal @default(0) @db.Decimal(14, 2)
  position    Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id             String        @id @default(cuid())
  invoiceId      String
  recordedById   Int?
  amount         Decimal       @db.Decimal(14, 2)
  method         PaymentMethod @default(BANK_TRANSFER)
  reference      String?
  notes          String?       @db.Text
  paidAt         DateTime      @default(now())
  createdAt      DateTime      @default(now())

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy User?   @relation("RecordedPayments", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("payments")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

model UserDocument {
  id          String   @id @default(cuid())
  userId      Int
  title       String
  category    String   @default("OTHER") // OFFER_LETTER, ID_PROOF, CONTRACT, EXPERIENCE, SALARY_SLIP, OTHER
  fileUrl     String
  fileName    String
  fileSize    Int?
  fileType    String?
  uploadedAt  DateTime @default(now())
  notes       String?  @db.Text

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_documents")
}

model Lead {
  id                  String         @id @default(cuid())
  title               String
  name                String
  company             String?
  email               String?
  phone               String?
  source              String?        @default("INBOUND")
  status              LeadStatus     @default(NEW)
  estimatedValue      Decimal?       @db.Decimal(14, 2)
  currency            String         @default("INR")
  assignedToId        Int?
  createdById         Int?
  notes               String?        @db.Text
  requirements        String?        @db.Text
  nextFollowUp        DateTime?
  lostReason          String?
  convertedToClientId String?
  convertedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  assignedTo          User?          @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy           User?          @relation("CreatedLeads", fields: [createdById], references: [id], onDelete: SetNull)
  activities          LeadActivity[]

  @@index([status])
  @@index([assignedToId])
  @@index([createdById])
  @@map("leads")
}

model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  userId    Int?
  type      String   @default("NOTE")
  content   String   @db.Text
  createdAt DateTime @default(now())

  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_activities")
}
