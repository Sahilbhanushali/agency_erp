  verifiedAt      DateTime?
  verifiedById    Int?
  rejectionReason String?   @db.Text
  notes           String?   @db.Text

  user            User      @relation("EmployeeDocuments", fields: [userId], references: [id], onDelete: Cascade)
  uploadedBy      User?     @relation("UploadedUserDocuments", fields: [uploadedById], references: [id], onDelete: SetNull)
  verifiedBy      User?     @relation("VerifiedUserDocuments", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([uploadedById])
  @@index([verifiedById])
  @@map("user_documents")
}

model Lead {
  id                  String         @id @default(cuid())
  title               String
  name                String
  company             String?
  email               String?
  phone               String?
  source              String?        @default("INBOUND")
  status              LeadStatus     @default(NEW)
  estimatedValue      Decimal?       @db.Decimal(14, 2)
  currency            String         @default("INR")
  assignedToId        Int?
  createdById         Int?
  notes               String?        @db.Text
  requirements        String?        @db.Text
  nextFollowUp        DateTime?
  lostReason          String?
  website             String?
  city                String?
  country             String?
  convertedToClientId String?
  convertedAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  assignedTo          User?          @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy           User?          @relation("CreatedLeads", fields: [createdById], references: [id], onDelete: SetNull)
  activities          LeadActivity[]

  @@index([status])
  @@index([assignedToId])
  @@index([createdById])
  @@map("leads")
