model LeadActivity {
  id        String   @id @default(cuid())
  leadId    String
  userId    Int?
  type      String   @default("NOTE")
  content   String   @db.Text
  createdAt DateTime @default(now())

  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_activities")
