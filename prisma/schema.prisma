  type               String                     @default("ONLINE") // ONLINE, TELEPHONE, IN_PERSON
  status             String                     @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED, MISSED, RESCHEDULED
  scheduledDate      DateTime
  startTime          String
  endTime            String
