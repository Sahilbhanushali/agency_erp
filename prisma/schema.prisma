  project          Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy        User?          @relation("CreatedContracts", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([projectId])
  @@index([status])
  @@index([renewalDate])
  @@map("contracts")
}

// =============================================================================
// APPROVAL WORKFLOWS & VISUAL PROOFING
// Multi-stage sequential/parallel approval chains + pin-point image proofing
// =============================================================================

enum ApprovalStageType {
  INTERNAL_LEAD
  ACCOUNT_MANAGER
  CLIENT
}

enum ApprovalStepStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  SKIPPED
}

model ApprovalChain {
  id                String         @id @default(cuid())
  postId            String
  currentStageIndex Int            @default(0)
  isCompleted       Boolean        @default(false)
  finalStatus       String         @default("IN_REVIEW") // IN_REVIEW, APPROVED, CHANGES_REQUESTED, REJECTED
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  post              Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  steps             ApprovalStep[]

  @@index([postId])
  @@index([finalStatus])
  @@map("approval_chains")
}

model ApprovalStep {
  id             String             @id @default(cuid())
  chainId        String
  stage          ApprovalStageType
  order          Int                @default(0)
  status         ApprovalStepStatus @default(PENDING)
  decisionAt     DateTime?
  decisionById   Int?
  decisionByName String?
  feedback       String?            @db.Text
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  chain          ApprovalChain      @relation(fields: [chainId], references: [id], onDelete: Cascade)
  decisionBy     User?              @relation("StepDecisions", fields: [decisionById], references: [id], onDelete: SetNull)

  @@index([chainId])
  @@index([stage])
  @@index([status])
  @@map("approval_steps")
}

model ProofAnnotation {
  id         String                 @id @default(cuid())
  assetId    String?
  postId     String
  x          Float                  // percentage coordinate (0-100)
  y          Float                  // percentage coordinate (0-100)
  color      String?                @default("#ef4444")
  comment    String                 @db.Text
  authorName String
  authorRole String?
  userId     Int?
  isResolved Boolean                @default(false)
  resolvedAt DateTime?
  resolvedBy String?
  version    Int                    @default(1)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  post       Post                   @relation(fields: [postId], references: [id], onDelete: Cascade)
  asset      Asset?                 @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user       User?                  @relation("CreatedAnnotations", fields: [userId], references: [id], onDelete: SetNull)
  replies    ProofAnnotationReply[]

  @@index([postId])
  @@index([assetId])
  @@index([isResolved])
  @@map("proof_annotations")
}

model ProofAnnotationReply {
  id           String          @id @default(cuid())
  annotationId String
  content      String          @db.Text
  authorName   String
  authorRole   String?
  userId       Int?
  createdAt    DateTime        @default(now())

  annotation   ProofAnnotation @relation(fields: [annotationId], references: [id], onDelete: Cascade)
  user         User?           @relation("UserReplies", fields: [userId], references: [id], onDelete: SetNull)

  @@index([annotationId])
  @@map("proof_annotation_replies")
}

// =============================================================================
// EXPENSE MANAGEMENT & PROFITABILITY TRACKER
// Project & Client direct costs, software subscriptions, freelancers, ad spend
// =============================================================================

enum ExpenseCategory {
  SOFTWARE_TOOL
  CONTRACTOR_FREELANCER
  AD_SPEND
  SHOOT_PRODUCTION
  OFFICE_TRAVEL
  HARDWARE_EQUIPMENT
  PAYROLL_SALARY
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  REIMBURSED
}

model Expense {
  id            String          @id @default(cuid())
  title         String
  category      ExpenseCategory @default(OTHER)
  amount        Decimal         @db.Decimal(14, 2)
  currency      String          @default("INR")
  date          DateTime        @default(now())
  isBillable    Boolean         @default(false)
  status        ExpenseStatus   @default(APPROVED)
  paymentMethod PaymentMethod   @default(BANK_TRANSFER)

  receiptUrl    String?         // Receipt PDF/Image
  receiptName   String?
  notes         String?         @db.Text

  // Relations
  projectId     String?
  clientId      String?
  userId        Int?            // Member who incurred the expense
  recordedById  Int?            // Finance/Admin who recorded/approved
  invoiceId     String?         // Linked client invoice if re-billed
  payrollRunId  String?         // Linked payroll run if payroll expense

  project       Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  client        Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  user          User?           @relation("UserExpenses", fields: [userId], references: [id], onDelete: SetNull)
  recordedBy    User?           @relation("RecordedExpenses", fields: [recordedById], references: [id], onDelete: SetNull)
  invoice       Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
