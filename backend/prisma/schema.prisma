// =============================================================================
// itsmeDezino — AGENCY MANAGEMENT PLATFORM
// Prisma Schema v3 — MySQL 8 (Hostinger VPS)
// -----------------------------------------------------------------------------
// v3 changes:
//   • All tables prefixed `itsme_`
//   • Normalised to 3NF — repeating groups, derived columns and boolean
//     explosions extracted into proper relations
//   • Soft delete (deletedAt / deletedBy) on every business entity
//   • Central File table — file metadata stored once, referenced everywhere
//   • Derived values removed — computed at query time, never stored
// -----------------------------------------------------------------------------
// SOFT DELETE CONTRACT
//   Every soft-deletable model has `deletedAt` + `deletedBy`.
//   All read queries MUST filter `where: { deletedAt: null }` via a Prisma
//   client extension. Never hard-delete business records.
//   `deletedBy` stores a userId as a plain string (no FK) so audit history
//   survives even if the deleting user is later removed.
//
//   UNIQUE COLUMNS + SOFT DELETE: MySQL unique indexes ignore deletedAt, so a
//   soft-deleted row still occupies its unique value. On soft delete the
//   service layer MUST anonymise unique columns, e.g.
//     email -> `deleted_{timestamp}_{email}`
//   Applies to: User.email, User.phone, ClientPortalUser.email,
//   File.storageKey, Quotation.quotationNumber, Invoice.invoiceNumber,
//   EmployeeProfile.employeeCode.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

