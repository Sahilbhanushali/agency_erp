// =============================================================================
// MARKETING AGENCY MANAGEMENT SOFTWARE
// Prisma Schema — MySQL + Full Feature Set
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  INVITED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  FREELANCER
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  IN_REVIEW
  COMPLETED
  ARCHIVED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  NEEDS_REVISION
  ADMIN_APPROVED
  CLIENT_PENDING
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  REMOTE
  ON_LEAVE
  HOLIDAY
}

enum LeaveType {
  ANNUAL
  SICK
  CASUAL
  MATERNITY
  PATERNITY
  UNPAID
  COMPENSATORY
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  AUTO_APPROVED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  VIEWED
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHEQUE
  STRIPE
  RAZORPAY
  UPI
  OTHER
}

enum PayrollStatus {
  PROCESSING
  GENERATED
  APPROVED
  PAID
  HELD
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  REIMBURSED
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  TWITTER_X
  YOUTUBE
  GOOGLE
  TIKTOK
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  FAILED
  CANCELLED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  SMS
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_STATUS_CHANGED
  TASK_COMMENT
  PROJECT_CREATED
  PROJECT_STATUS_CHANGED
  LEAVE_REQUESTED
  LEAVE_STATUS_CHANGED
  INVOICE_SENT
  INVOICE_OVERDUE
  PAYMENT_RECEIVED
  QUOTATION_SENT
  QUOTATION_ACCEPTED
  ATTENDANCE_FLAGGED
  PAYROLL_GENERATED
  DOCUMENT_UPLOADED
  CLIENT_APPROVAL_REQUIRED
  SOCIAL_POST_PUBLISHED
  SOCIAL_POST_FAILED
  MENTION
  SYSTEM_ALERT
}

enum ActivityEntity {
  USER
  CLIENT
  PROJECT
  TASK
  TASK_COMMENT
  INVOICE
  QUOTATION
  PAYMENT
  PAYROLL
  ATTENDANCE
  LEAVE
  DOCUMENT
  SOCIAL_CONNECTION
  SCHEDULED_POST
  EXPENSE
  ROLE
  CLIENT_PORTAL_CONFIG
}

enum ActivityAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
  SEND
  EXPORT
  IMPORT
  ARCHIVE
  RESTORE
  UPLOAD
  DOWNLOAD
  TOGGLE
  ASSIGN
  UNASSIGN
}

enum DocumentCategory {
  CONTRACT
  PROPOSAL
  CREATIVE_ASSET
  REPORT
  INVOICE_ATTACHMENT
  BRAND_GUIDELINE
  OTHER
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  MISSED
}

// =============================================================================
// USER MANAGEMENT & RBAC
// =============================================================================

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. SUPER_ADMIN, ADMIN, MANAGER, EMPLOYEE, CLIENT
  displayName String
  description String?  @db.Text
  isSystem    Boolean  @default(false) // system roles cannot be deleted
  permissions Json     // { module: string, actions: string[] }[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@map("roles")
}

model User {
  id             String         @id @default(uuid())
  roleId         String
  firstName      String
  lastName       String
  email          String         @unique
  phone          String?        @unique
  passwordHash   String
  avatar         String?        // S3 URL
  status         UserStatus     @default(INVITED)
  gender         Gender?
  dateOfBirth    DateTime?
  address        String?        @db.Text
  employmentType EmploymentType?
  department     String?
  designation    String?
  joiningDate    DateTime?
  baseSalary     Decimal?       @db.Decimal(12, 2)
  isRemote       Boolean        @default(false)
  // Leave balances (in days)
  annualLeaveBalance      Int   @default(18)
  sickLeaveBalance        Int   @default(10)
  casualLeaveBalance      Int   @default(6)
  compensatoryLeaveBalance Int  @default(0)
  lastLoginAt    DateTime?
  emailVerifiedAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  role                   Role                    @relation(fields: [roleId], references: [id])
  refreshTokens          RefreshToken[]
  managedProjects        Project[]               @relation("ProjectManager")
  assignedTasks          Task[]                  @relation("TaskAssignee")
  createdTasks           Task[]                  @relation("TaskCreator")
  taskTimeLogs           TaskTimeLog[]
  taskComments           TaskComment[]
  attendanceRecords      AttendanceRecord[]
  leaveRequests          LeaveRequest[]          @relation("LeaveEmployee")
  approvedLeaves         LeaveRequest[]          @relation("LeaveApprover")
  createdInvoices        Invoice[]               @relation("InvoiceCreator")
  createdQuotations      Quotation[]             @relation("QuotationCreator")
  payrollSlips           PayrollSlip[]
  submittedExpenses      Expense[]
  approvedExpenses       Expense[]               @relation("ExpenseApprover")
  uploadedDocuments      Document[]
  notifications          Notification[]
  activityLogs           ActivityLog[]
  notificationPreferences NotificationPreference[]
  clientPortalConfigsUpdated ClientPortalConfig[] @relation("ConfigUpdater")

  @@index([roleId])
  @@index([email])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique @db.VarChar(512)
  userAgent String?  @db.Text
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// =============================================================================
// CLIENT MANAGEMENT (CRM)
// =============================================================================

model Client {
  id              String   @id @default(uuid())
  companyName     String
  industry        String?
  website         String?
  logoUrl         String?  // S3 URL
  email           String   @unique
  phone           String?
  billingAddress  String?  @db.Text
  gstNumber       String?
  panNumber       String?
  notes           String?  @db.Text
  isActive        Boolean  @default(true)
  accountManagerId String? // userId of the managing employee
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contacts            ClientContact[]
  portalUsers         ClientPortalUser[]
  projects            Project[]
  invoices            Invoice[]
  quotations          Quotation[]
  documents           Document[]
  calendarEvents      ClientCalendarEvent[]
  portalConfig        ClientPortalConfig?
  socialConnections   SocialConnection[]
  campaignMetrics     CampaignMetric[]

  @@index([isActive])
  @@map("clients")
}

model ClientContact {
  id          String   @id @default(uuid())
  clientId    String
  name        String
  designation String?
  email       String?
  phone       String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_contacts")
}

model ClientPortalUser {
  id           String    @id @default(uuid())
  clientId     String
  name         String
  email        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([clientId])
  @@map("client_portal_users")
}

// Admin-controlled visibility toggles for what each client sees in their portal
model ClientPortalConfig {
  id        String  @id @default(uuid())
  clientId  String  @unique
  updatedBy String  // adminUserId

  // ── Campaign & Social Visibility ──
  showCampaignLeads     Boolean @default(false)
  showLeadResponses     Boolean @default(false)
  showPostInsights      Boolean @default(false)
  showPostsDelivered    Boolean @default(false)
  showActiveWork        Boolean @default(false)
  showScheduledPosts    Boolean @default(false)
  showSocialAnalytics   Boolean @default(false)

  // ── Financial Visibility ──
  showInvoices          Boolean @default(true)
  showQuotations        Boolean @default(true)
  showPaymentStatus     Boolean @default(true)
  showProjectBudget     Boolean @default(false)

  // ── Project Visibility ──
  showProjectTimeline   Boolean @default(false)
  showMilestones        Boolean @default(true)
  showDeliverables      Boolean @default(true)

  // ── These are NEVER exposed to clients (no toggle — hardcoded off) ──
  // - Internal task board & task details
  // - Employee names, assignments, contact info
  // - Internal comments and notes
  // - Ad spend breakdown / cost data
  // - Payroll / salary data
  // - Raw time logs

  updatedAt DateTime @updatedAt

  client      Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  updatedByUser User @relation("ConfigUpdater", fields: [updatedBy], references: [id])

  @@map("client_portal_configs")
}

model ClientCalendarEvent {
  id          String   @id @default(uuid())
  clientId    String
  projectId   String?
  title       String
  description String?  @db.Text
  startDate   DateTime
  endDate     DateTime
  isAllDay    Boolean  @default(false)
  color       String?  @default("#6366f1")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([startDate])
  @@map("client_calendar_events")
}

// =============================================================================
// PROJECTS & TASKS
// =============================================================================

model Project {
  id                    String        @id @default(uuid())
  clientId              String
  managerId             String
  title                 String
  description           String?       @db.Text
  status                ProjectStatus @default(DRAFT)
  startDate             DateTime?
  deadline              DateTime?
  budget                Decimal?      @db.Decimal(12, 2)
  billableRate          Decimal?      @db.Decimal(10, 2) // per hour
  currency              String        @default("INR")
  clientApprovalEnabled Boolean       @default(false) // if true, tasks go CLIENT_PENDING after ADMIN_APPROVED
  color                 String?       @default("#6366f1")
  tags                  Json?         // string[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  client         Client               @relation(fields: [clientId], references: [id])
  manager        User                 @relation("ProjectManager", fields: [managerId], references: [id])
  tasks          Task[]
  milestones     ProjectMilestone[]
  invoices       Invoice[]
  quotations     Quotation[]
  documents      Document[]
  calendarEvents ClientCalendarEvent[]

  @@index([clientId])
  @@index([managerId])
  @@index([status])
  @@map("projects")
}

model ProjectMilestone {
  id          String          @id @default(uuid())
  projectId   String
  title       String
  description String?         @db.Text
  dueDate     DateTime
  status      MilestoneStatus @default(PENDING)
  showToClient Boolean        @default(true)
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]  @relation("MilestoneTasks")

  @@index([projectId])
  @@map("project_milestones")
}

model Task {
  id              String       @id @default(uuid())
  projectId       String
  milestoneId     String?
  parentTaskId    String?      // for sub-tasks
  createdBy       String
  assigneeId      String?
  title           String
  description     String?      @db.Text
  status          TaskStatus   @default(TODO)
  priority        TaskPriority @default(MEDIUM)
  dueDate         DateTime?
  estimatedHours  Decimal?     @db.Decimal(6, 2)
  loggedHours     Decimal      @default(0) @db.Decimal(8, 2)
  showToClient    Boolean      @default(false) // controls "actively working on" visibility
  clientLabel     String?      // sanitised label shown in client portal (e.g. "Reel series")
  position        Int          @default(0)    // for drag-and-drop ordering within status column
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone   ProjectMilestone? @relation("MilestoneTasks", fields: [milestoneId], references: [id], onDelete: SetNull)
  parentTask  Task?             @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subTasks    Task[]            @relation("SubTasks")
  creator     User              @relation("TaskCreator", fields: [createdBy], references: [id])
  assignee    User?             @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  timeLogs    TaskTimeLog[]
  comments    TaskComment[]
  attachments TaskAttachment[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([parentTaskId])
  @@map("tasks")
}

model TaskTimeLog {
  id          String    @id @default(uuid())
  taskId      String
  userId      String
  description String?   @db.Text
  startedAt   DateTime
  endedAt     DateTime?
  durationMin Int?      // calculated on clock-out
  isBillable  Boolean   @default(true)
  createdAt   DateTime  @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([userId])
  @@index([startedAt])
  @@map("task_time_logs")
}

model TaskComment {
  id          String   @id @default(uuid())
  taskId      String
  userId      String
  content     String   @db.Text
  isInternal  Boolean  @default(true) // internal comments never shown to client
  parentId    String?  // for threaded replies
  editedAt    DateTime?
  createdAt   DateTime @default(now())

  task        Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id])
  parent      TaskComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies     TaskComment[] @relation("CommentReplies")
  attachments TaskAttachment[]

  @@index([taskId])
  @@index([userId])
  @@map("task_comments")
}

model TaskAttachment {
  id         String   @id @default(uuid())
  taskId     String?
  commentId  String?
  fileName   String
  fileSize   Int      // bytes
  mimeType   String
  s3Key      String
  s3Url      String   @db.Text
  uploadedBy String
  createdAt  DateTime @default(now())

  task    Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment TaskComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_attachments")
}

// =============================================================================
// HR — ATTENDANCE & LEAVE
// =============================================================================

model OfficeGeofence {
  id        String   @id @default(uuid())
  name      String   // e.g. "Mumbai HQ", "Delhi Branch"
  latitude  Decimal  @db.Decimal(10, 7)
  longitude Decimal  @db.Decimal(10, 7)
  radiusM   Int      // allowed radius in metres
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("office_geofences")
}

model AttendanceRecord {
  id              String           @id @default(uuid())
  userId          String
  date            DateTime         @db.Date
  clockIn         DateTime?
  clockOut        DateTime?
  clockInLat      Decimal?         @db.Decimal(10, 7)
  clockInLng      Decimal?         @db.Decimal(10, 7)
  clockOutLat     Decimal?         @db.Decimal(10, 7)
  clockOutLng     Decimal?         @db.Decimal(10, 7)
  status          AttendanceStatus @default(PRESENT)
  isRemote        Boolean          @default(false)
  workingMinutes  Int?             // calculated on clock-out
  overtimeMinutes Int              @default(0)
  notes           String?          @db.Text
  approvedBy      String?          // manager userId if manual entry
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@index([status])
  @@map("attendance_records")
}

model Holiday {
  id          String   @id @default(uuid())
  name        String
  date        DateTime @db.Date
  isOptional  Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())

  @@index([date])
  @@map("holidays")
}

model LeaveRequest {
  id           String      @id @default(uuid())
  userId       String
  approverId   String?
  leaveType    LeaveType
  status       LeaveStatus @default(PENDING)
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  totalDays    Decimal     @db.Decimal(4, 1)
  reason       String?     @db.Text
  rejectionNote String?    @db.Text
  appliedAt    DateTime    @default(now())
  actionAt     DateTime?   // when approved/rejected
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  employee User  @relation("LeaveEmployee", fields: [userId], references: [id])
  approver User? @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([startDate])
  @@map("leave_requests")
}

// =============================================================================
// FINANCE — QUOTATIONS
// =============================================================================

model Quotation {
  id             String          @id @default(uuid())
  clientId       String
  projectId      String?
  createdBy      String          // always adminUserId — enforced by RolesGuard
  quotationNumber String         @unique // e.g. QUO-2026-0042
  title          String
  description    String?         @db.Text
  status         QuotationStatus @default(DRAFT)
  currency       String          @default("INR")
  subTotal       Decimal         @db.Decimal(12, 2)
  discountPercent Decimal        @default(0) @db.Decimal(5, 2)
  discountAmount Decimal         @default(0) @db.Decimal(12, 2)
  taxPercent     Decimal         @default(18) @db.Decimal(5, 2)
  taxAmount      Decimal         @db.Decimal(12, 2)
  totalAmount    Decimal         @db.Decimal(12, 2)
  validUntil     DateTime
  termsAndConditions String?     @db.Text
  notes          String?         @db.Text
  portalVisible  Boolean         @default(false) // admin controls client visibility
  pdfUrl         String?         // S3 URL of generated PDF
  sentAt         DateTime?
  convertedToInvoiceAt DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  client    Client          @relation(fields: [clientId], references: [id])
  project   Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  creator   User            @relation("QuotationCreator", fields: [createdBy], references: [id])
  lineItems QuotationLine[]
  invoice   Invoice?        // if converted

  @@index([clientId])
  @@index([status])
  @@map("quotations")
}

model QuotationLine {
  id          String  @id @default(uuid())
  quotationId String
  description String  @db.Text
  quantity    Decimal @db.Decimal(8, 2)
  unit        String? // e.g. "hrs", "posts", "months"
  unitPrice   Decimal @db.Decimal(12, 2)
  totalPrice  Decimal @db.Decimal(12, 2)
  position    Int     @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_lines")
}

// =============================================================================
// FINANCE — INVOICES & PAYMENTS
// =============================================================================

model Invoice {
  id             String        @id @default(uuid())
  clientId       String
  projectId      String?
  quotationId    String?       @unique // populated if converted from quotation
  createdBy      String        // always adminUserId — enforced by RolesGuard
  invoiceNumber  String        @unique // e.g. INV-2026-0087
  title          String
  status         InvoiceStatus @default(DRAFT)
  currency       String        @default("INR")
  subTotal       Decimal       @db.Decimal(12, 2)
  discountPercent Decimal      @default(0) @db.Decimal(5, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  taxPercent     Decimal       @default(18) @db.Decimal(5, 2)
  taxAmount      Decimal       @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  dueDate        DateTime
  issueDate      DateTime      @default(now())
  termsAndConditions String?   @db.Text
  notes          String?       @db.Text
  portalVisible  Boolean       @default(true) // admin controls client visibility
  pdfUrl         String?       // S3 URL of generated PDF
  sentAt         DateTime?
  paidAt         DateTime?
  overdueNotifiedAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  client    Client         @relation(fields: [clientId], references: [id])
  project   Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  quotation Quotation?     @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  creator   User           @relation("InvoiceCreator", fields: [createdBy], references: [id])
  lineItems InvoiceLine[]
  payments  Payment[]

  @@index([clientId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String
  description String  @db.Text
  quantity    Decimal @db.Decimal(8, 2)
  unit        String? // e.g. "hrs", "posts", "months"
  unitPrice   Decimal @db.Decimal(12, 2)
  totalPrice  Decimal @db.Decimal(12, 2)
  position    Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id            String        @id @default(uuid())
  invoiceId     String
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("INR")
  method        PaymentMethod
  transactionId String?       // gateway reference
  gatewayName   String?       // e.g. "razorpay", "stripe"
  gatewayPayload Json?        // raw webhook payload for audit
  note          String?
  paidAt        DateTime
  recordedBy    String        // adminUserId who recorded it
  createdAt     DateTime      @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@map("payments")
}

// =============================================================================
// FINANCE — PAYROLL
// =============================================================================

model PayrollSlip {
  id              String        @id @default(uuid())
  userId          String
  month           Int           // 1–12
  year            Int
  status          PayrollStatus @default(PROCESSING)
  // Earnings
  basicSalary     Decimal       @db.Decimal(12, 2)
  overtime        Decimal       @default(0) @db.Decimal(12, 2)
  bonus           Decimal       @default(0) @db.Decimal(12, 2)
  allowances      Decimal       @default(0) @db.Decimal(12, 2)
  grossPay        Decimal       @db.Decimal(12, 2)
  // Deductions
  taxDeduction    Decimal       @default(0) @db.Decimal(12, 2)
  pf              Decimal       @default(0) @db.Decimal(12, 2)
  esic            Decimal       @default(0) @db.Decimal(12, 2)
  leaveDed        Decimal       @default(0) @db.Decimal(12, 2)
  otherDeductions Decimal       @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal       @db.Decimal(12, 2)
  netPay          Decimal       @db.Decimal(12, 2)
  // Summary
  workingDays     Int
  presentDays     Int
  leaveDays       Int
  overtimeHours   Decimal       @default(0) @db.Decimal(6, 2)
  pdfUrl          String?       // S3 URL
  approvedBy      String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, month, year])
  @@index([userId])
  @@index([status])
  @@map("payroll_slips")
}

// =============================================================================
// FINANCE — EXPENSES
// =============================================================================

model Expense {
  id          String        @id @default(uuid())
  submittedBy String
  approvedBy  String?
  category    String        // e.g. "Travel", "Software", "Office Supplies"
  description String        @db.Text
  amount      Decimal       @db.Decimal(10, 2)
  currency    String        @default("INR")
  receiptUrl  String?       // S3 URL
  status      ExpenseStatus @default(PENDING)
  rejectionNote String?     @db.Text
  incurredAt  DateTime
  reimbursedAt DateTime?
  projectId   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  employee User  @relation(fields: [submittedBy], references: [id])
  approver User? @relation("ExpenseApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([submittedBy])
  @@index([status])
  @@map("expenses")
}

// =============================================================================
// SOCIAL MEDIA INTEGRATIONS
// =============================================================================

model SocialConnection {
  id              String         @id @default(uuid())
  clientId        String
  platform        SocialPlatform
  accountId       String         // platform's page/profile ID
  accountName     String
  accountType     String?        // "page", "profile", "business"
  accessToken     String         @db.Text // AES-256 encrypted
  refreshToken    String?        @db.Text // AES-256 encrypted
  tokenExpiresAt  DateTime?
  scopes          Json?          // string[] of granted scopes
  isActive        Boolean        @default(true)
  lastSyncAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  client         Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scheduledPosts ScheduledPost[]
  insights       SocialInsight[]

  @@unique([clientId, platform, accountId])
  @@index([clientId])
  @@index([tokenExpiresAt])
  @@map("social_connections")
}

model ScheduledPost {
  id               String           @id @default(uuid())
  socialConnectionId String
  projectId        String?
  caption          String           @db.Text
  mediaUrls        Json             // string[] of S3 URLs
  hashtags         Json?            // string[]
  status           PostStatus       @default(DRAFT)
  scheduledAt      DateTime
  publishedAt      DateTime?
  platformPostId   String?          // ID returned by platform after publish
  failureReason    String?          @db.Text
  createdBy        String           // userId
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  socialConnection SocialConnection @relation(fields: [socialConnectionId], references: [id], onDelete: Cascade)

  @@index([socialConnectionId])
  @@index([status])
  @@index([scheduledAt])
  @@map("scheduled_posts")
}

model SocialInsight {
  id               String         @id @default(uuid())
  socialConnectionId String
  platform         SocialPlatform
  fetchedAt        DateTime       @default(now())
  periodStart      DateTime
  periodEnd        DateTime
  // Reach & Engagement
  reach            Int            @default(0)
  impressions      Int            @default(0)
  engagements      Int            @default(0)
  engagementRate   Decimal        @default(0) @db.Decimal(6, 4)
  // Content
  postsPublished   Int            @default(0)
  // Audience
  followerCount    Int            @default(0)
  followerGrowth   Int            @default(0)
  // Paid
  adSpend          Decimal        @default(0) @db.Decimal(12, 2)
  adImpressions    Int            @default(0)
  adClicks         Int            @default(0)
  costPerClick     Decimal        @default(0) @db.Decimal(8, 2)
  // Campaign Leads (for Meta Lead Ads)
  leadsGenerated   Int            @default(0)
  leadResponses    Int            @default(0)

  socialConnection SocialConnection @relation(fields: [socialConnectionId], references: [id], onDelete: Cascade)

  @@index([socialConnectionId])
  @@index([periodStart])
  @@map("social_insights")
}

model CampaignMetric {
  id          String   @id @default(uuid())
  clientId    String
  campaignName String
  platform    SocialPlatform
  periodStart DateTime
  periodEnd   DateTime
  leads       Int      @default(0)
  responses   Int      @default(0)
  conversions Int      @default(0)
  spend       Decimal  @default(0) @db.Decimal(12, 2)
  revenue     Decimal  @default(0) @db.Decimal(12, 2)
  notes       String?  @db.Text
  fetchedAt   DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([periodStart])
  @@map("campaign_metrics")
}

// =============================================================================
// DOCUMENT MANAGEMENT
// =============================================================================

model Document {
  id           String           @id @default(uuid())
  clientId     String?
  projectId    String?
  uploadedBy   String
  name         String
  description  String?          @db.Text
  category     DocumentCategory @default(OTHER)
  mimeType     String
  fileSize     Int              // bytes
  s3Key        String
  s3Url        String           @db.Text
  version      Int              @default(1)
  parentId     String?          // for versioning — points to original document
  isClientVisible Boolean       @default(false) // admin controls visibility
  tags         Json?            // string[]
  createdAt    DateTime         @default(now())

  client   Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  uploader User     @relation(fields: [uploadedBy], references: [id])
  parent   Document?   @relation("DocumentVersions", fields: [parentId], references: [id], onDelete: SetNull)
  versions Document[]  @relation("DocumentVersions")

  @@index([clientId])
  @@index([projectId])
  @@index([parentId])
  @@map("documents")
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

model Notification {
  id               String             @id @default(uuid())
  userId           String?            // internal user (admin/employee)
  clientPortalUserId String?          // client portal user
  type             NotificationType
  title            String
  body             String             @db.Text
  entity           ActivityEntity?
  entityId         String?
  actionUrl        String?
  isRead           Boolean            @default(false)
  readAt           DateTime?
  channel          NotificationChannel @default(IN_APP)
  sentAt           DateTime?
  createdAt        DateTime           @default(now())

  user           User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientPortalUser ClientPortalUser? @relation(fields: [clientPortalUserId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([clientPortalUserId])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id      String              @id @default(uuid())
  userId  String
  type    NotificationType
  inApp   Boolean             @default(true)
  email   Boolean             @default(true)
  push    Boolean             @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("notification_preferences")
}

// =============================================================================
// ACTIVITY LOG (AUDIT TRAIL)
// =============================================================================

model ActivityLog {
  id        String         @id @default(uuid())
  userId    String?        // null for system-generated actions
  action    ActivityAction
  entity    ActivityEntity
  entityId  String
  summary   String         @db.Text // human-readable e.g. "Admin approved task #42"
  before    Json?          // snapshot before change
  after     Json?          // snapshot after change
  ipAddress String?
  userAgent String?        @db.Text
  createdAt DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}
