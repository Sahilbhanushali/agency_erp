// =============================================================================
// CORE — COMPANY (TOP-LEVEL TENANT) & SHARED LOOKUPS
// =============================================================================

model Company {
  id                  String    @id @default(uuid())
  registeredAddressId String?
  name                String
  legalName           String?
  logoUrl             String?
  email               String?
  phone               String?
  website             String?
  gstNumber           String?
  panNumber           String?
  currency            String    @default("INR")
  timezone            String    @default("Asia/Kolkata")
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?
  deletedBy           String?

  registeredAddress Address? @relation("CompanyRegisteredAddress", fields: [registeredAddressId], references: [id], onDelete: SetNull)

  roles             Role[]
  users             User[]
  files             File[]
  clients           Client[]
  projects          Project[]
  workspaces        Workspace[]
  tasks             Task[]
  posts             Post[]
  tags              Tag[]
  packages          Package[]
  clientPackages    ClientPackage[]
  campaigns         Campaign[]
  lists             List[]
  officeLocations   OfficeLocation[]
  holidays          Holiday[]
  leaveTypes        LeaveType[]
  quotations        Quotation[]
  invoices          Invoice[]
  expenses          Expense[]
  chatConversations ChatConversation[]
  socialAccounts    SocialAccount[]
  documents         Document[]

  @@index([registeredAddressId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("itsme_companies")
}

// Normalised address — replaces free-text address columns previously repeated
// across Company, Client and EmployeeProfile.
model Address {
  id         String   @id @default(uuid())
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String?
  country    String   @default("India")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  companiesRegistered Company[]         @relation("CompanyRegisteredAddress")
  clientsBilling      Client[]          @relation("ClientBillingAddress")
  employeesCurrent    EmployeeProfile[] @relation("EmployeeCurrentAddress")
  employeesPermanent  EmployeeProfile[] @relation("EmployeePermanentAddress")
  officeLocations     OfficeLocation[]

  @@index([city])
  @@map("itsme_addresses")
}

// =============================================================================
// RBAC — permissions normalised out of the old Role.permissions JSON blob
// =============================================================================

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "invoices:create"
  module      String            // e.g. "invoices"
  action      String            // e.g. "create"
  description String?  @db.Text
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@index([module])
  @@map("itsme_permissions")
}

model Role {
  id          String    @id @default(uuid())
  companyId   String?   // null = platform-level system role
  name        String
  displayName String
  description String?   @db.Text
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedBy   String?

  company     Company?         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  users       User[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([deletedAt])
  @@map("itsme_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("itsme_role_permissions")
}

// =============================================================================
// USERS & EMPLOYEE RECORDS
// =============================================================================

model User {
  id              String          @id @default(uuid())
  companyId       String?         // null only for the platform SUPER_ADMIN
  roleId          String
  firstName       String
  lastName        String
  email           String          @unique
  phone           String?         @unique
  passwordHash    String
  avatarUrl       String?
  status          UserStatus      @default(INVITED)
  inviteTokenHash String?         @unique
  inviteTokenExpiresAt DateTime?
  gender          Gender?
  dateOfBirth     DateTime?       @db.Date
  employmentType  EmploymentType?
  department      String?
  designation     String?
  joiningDate     DateTime?       @db.Date
  isRemote        Boolean         @default(false)
  lastLoginAt     DateTime?
  emailVerifiedAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  deletedBy       String?

  company Company? @relation(fields: [companyId], references: [id])
  role    Role     @relation(fields: [roleId], references: [id])

  employeeProfile         EmployeeProfile?
  directReportProfiles    EmployeeProfile[]        @relation("ReportingManager")
  refreshTokens           RefreshToken[]
  uploadedFiles           File[]                   @relation("FileUploader")
  managedClients          Client[]                 @relation("ClientAccountManager")
  managedProjects         Project[]                @relation("ProjectManager")
  workspaceMemberships    WorkspaceMember[]        @relation("WorkspaceMember")
  workspaceMembersAdded   WorkspaceMember[]        @relation("WorkspaceMemberAddedBy")
  createdTasks            Task[]                   @relation("TaskCreator")
  assignedTasks           Task[]                   @relation("TaskAssignee")
  taskTimeLogs            TaskTimeLog[]
  taskComments            TaskComment[]
  createdPosts            Post[]                   @relation("PostCreator")
  assignedPosts           Post[]                   @relation("PostAssignee")
  postTimelineActivities  PostTimelineActivity[]
  attendanceRecords       AttendanceRecord[]       @relation("AttendanceEmployee")
  approvedAttendance      AttendanceRecord[]       @relation("AttendanceApprover")
  leaveBalances           LeaveBalance[]
  leaveRequests           LeaveRequest[]           @relation("LeaveEmployee")
  approvedLeaves          LeaveRequest[]           @relation("LeaveApprover")
  createdPackages         Package[]                @relation("PackageCreator")
  createdCampaigns        Campaign[]               @relation("CampaignCreator")
  createdLists            List[]                   @relation("ListCreator")
  createdQuotations       Quotation[]              @relation("QuotationCreator")
  createdInvoices         Invoice[]                @relation("InvoiceCreator")
  recordedPayments        Payment[]                @relation("PaymentRecorder")
  submittedExpenses       Expense[]                @relation("ExpenseSubmitter")
  approvedExpenses        Expense[]                @relation("ExpenseApprover")
  employeeDocuments       Document[]               @relation("EmployeeDocuments")
  createdConversations    ChatConversation[]       @relation("ChatCreator")
  chatParticipations      ChatParticipant[]
  sentChatMessages        ChatMessage[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  portalPermissionUpdates ClientPortalPermission[] @relation("PortalPermissionUpdater")
  activityLogs            ActivityLog[]

  @@index([companyId])
  @@index([roleId])
  @@index([status])
  @@index([deletedAt])
  @@map("itsme_users")
}

// Extended employee detail — keeps the auth table lean.
model EmployeeProfile {
  id                       String         @id @default(uuid())
  userId                   String         @unique
  reportingManagerId       String?
  currentAddressId         String?
  permanentAddressId       String?
  employeeCode             String?        @unique
  bloodGroup               String?
  maritalStatus            MaritalStatus?
  nationality              String?
  personalEmail            String?
  alternatePhone           String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  panNumber                String?
  aadhaarNumber            String?
  passportNumber           String?
  probationEndDate         DateTime?      @db.Date
  confirmationDate         DateTime?      @db.Date
  note                     String?        @db.Text
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  deletedAt                DateTime?
  deletedBy                String?

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportingManager User?    @relation("ReportingManager", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  currentAddress   Address? @relation("EmployeeCurrentAddress", fields: [currentAddressId], references: [id], onDelete: SetNull)
  permanentAddress Address? @relation("EmployeePermanentAddress", fields: [permanentAddressId], references: [id], onDelete: SetNull)

  bankDetail EmployeeBankDetail?
  skills     EmployeeSkill[]

  @@index([reportingManagerId])
  @@index([currentAddressId])
  @@index([permanentAddressId])
  @@index([deletedAt])
  @@map("itsme_employee_profiles")
}

// Split out of EmployeeProfile — sensitive, separately access-controlled.
model EmployeeBankDetail {
  id                String    @id @default(uuid())
  employeeProfileId String    @unique
  accountHolderName String
  accountNumber     String
  bankName          String
  ifscCode          String
  branchName        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  deletedBy         String?

  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@map("itsme_employee_bank_details")
}

// Replaces EmployeeProfile.skills JSON array.
model EmployeeSkill {
  id                String   @id @default(uuid())
  employeeProfileId String
  name              String
  proficiency       Int? // 1-5
  createdAt         DateTime @default(now())

  employeeProfile EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@unique([employeeProfileId, name])
  @@index([employeeProfileId])
  @@map("itsme_employee_skills")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique @db.VarChar(512)
  userAgent String?   @db.Text
  ipAddress String?   @db.VarChar(45)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("itsme_refresh_tokens")
}

// =============================================================================
// FILES — single source of truth for every upload.
// Replaces the duplicated s3Key / mimeType / fileSize blocks that previously
// existed on attachments, documents, chat messages and expense receipts.
// =============================================================================

model File {
  id           String    @id @default(uuid())
  companyId    String
  uploadedById String
  originalName String
  storageKey   String    @unique // S3 object key
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  deletedBy    String?

  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploader User    @relation("FileUploader", fields: [uploadedById], references: [id])

  taskAttachments    TaskAttachment[]
  commentAttachments TaskCommentAttachment[]
  postMedia          PostMedia[]
  documents          Document[]
  chatMessages       ChatMessage[]
  expenseReceipts    Expense[]

  @@index([companyId])
  @@index([uploadedById])
  @@index([deletedAt])
  @@map("itsme_files")
}

// =============================================================================
// CLIENTS (CRM)
// =============================================================================

model Client {
  id               String    @id @default(uuid())
  companyId        String
  accountManagerId String?
  billingAddressId String?
  name             String
  industry         String?
  website          String?
  logoUrl          String?
  email            String
  phone            String?
  gstNumber        String?
  panNumber        String?
  note             String?   @db.Text
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  deletedBy        String?

  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accountManager User?    @relation("ClientAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  billingAddress Address? @relation("ClientBillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)

  contacts          ClientContact[]
  portalUsers       ClientPortalUser[]
  portalPermissions ClientPortalPermission[]
  calendarEvents    ClientCalendarEvent[]
  projects          Project[]
  posts             Post[]
  clientPackages    ClientPackage[]
  campaigns         Campaign[]
  lists             List[]
  quotations        Quotation[]
  invoices          Invoice[]
  socialAccounts    SocialAccount[]
  documents         Document[]

  @@unique([companyId, email])
  @@index([companyId])
  @@index([accountManagerId])
  @@index([billingAddressId])
  @@index([deletedAt])
  @@map("itsme_clients")
}

model ClientContact {
  id          String    @id @default(uuid())
  clientId    String
  name        String
  designation String?
  email       String?
  phone       String?
  isPrimary   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedBy   String?

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([deletedAt])
  @@map("itsme_client_contacts")
}

model ClientPortalUser {
  id           String    @id @default(uuid())
  clientId     String
  name         String
  email        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  deletedBy    String?

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([clientId])
  @@index([deletedAt])
  @@map("itsme_client_portal_users")
}

// Replaces the 16-boolean ClientPortalConfig table.
// One row per feature the admin has configured; absent row = hidden.
model ClientPortalPermission {
  id          String        @id @default(uuid())
  clientId    String
  updatedById String
  feature     PortalFeature
  isVisible   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  updatedBy User   @relation("PortalPermissionUpdater", fields: [updatedById], references: [id])

  @@unique([clientId, feature])
  @@index([clientId])
  @@index([updatedById])
  @@map("itsme_client_portal_permissions")
}

model ClientCalendarEvent {
  id          String    @id @default(uuid())
  clientId    String
  projectId   String?
  postId      String?
  title       String
  description String?   @db.Text
  startAt     DateTime
  endAt       DateTime
  isAllDay    Boolean   @default(false)
  colorHex    String?   @db.VarChar(7)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedBy   String?

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([projectId])
  @@index([postId])
  @@index([startAt])
  @@index([deletedAt])
  @@map("itsme_client_calendar_events")
}

// =============================================================================
// PROJECTS · WORKSPACES · MILESTONES
// =============================================================================

model Project {
  id                    String        @id @default(uuid())
  companyId             String
  clientId              String
  managerId             String
  title                 String
  description           String?       @db.Text
  status                ProjectStatus @default(DRAFT)
  startDate             DateTime?     @db.Date
  deadline              DateTime?     @db.Date
  budget                Decimal?      @db.Decimal(14, 2)
  currency              String        @default("INR")
  clientApprovalEnabled Boolean       @default(false)
  colorHex              String?       @db.VarChar(7)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  deletedAt             DateTime?
  deletedBy             String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id])
  manager User    @relation("ProjectManager", fields: [managerId], references: [id])

  workspaces     Workspace[]
  milestones     ProjectMilestone[]
  tasks          Task[]
  posts          Post[]
  tags           ProjectTag[]
  clientPackages ClientPackage[]
  campaigns      Campaign[]
  lists          List[]
  quotations     Quotation[]
  invoices       Invoice[]
  expenses       Expense[]
  documents      Document[]
  calendarEvents ClientCalendarEvent[]

  @@index([companyId])
  @@index([clientId])
  @@index([managerId])
  @@index([status])
  @@index([deletedAt])
  @@map("itsme_projects")
}

model Workspace {
  id          String    @id @default(uuid())
  companyId   String
  projectId   String
  name        String
  description String?   @db.Text
  colorHex    String?   @db.VarChar(7)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedBy   String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  members WorkspaceMember[]
  tasks   Task[]
  posts   Post[]

  @@unique([projectId, name])
  @@index([companyId])
  @@index([projectId])
  @@index([deletedAt])
  @@map("itsme_workspaces")
}

model WorkspaceMember {
  id          String              @id @default(uuid())
  workspaceId String
  userId      String
  addedById   String
  memberRole  WorkspaceMemberRole @default(MEMBER)
  createdAt   DateTime            @default(now())
  deletedAt   DateTime?
  deletedBy   String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("WorkspaceMember", fields: [userId], references: [id], onDelete: Cascade)
  addedBy   User      @relation("WorkspaceMemberAddedBy", fields: [addedById], references: [id])

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@index([addedById])
  @@index([deletedAt])
  @@map("itsme_workspace_members")
}

model ProjectMilestone {
  id           String          @id @default(uuid())
  projectId    String
  title        String
  description  String?         @db.Text
  dueDate      DateTime        @db.Date
  status       MilestoneStatus @default(PENDING)
  showToClient Boolean         @default(true)
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  deletedBy    String?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
  @@index([deletedAt])
  @@map("itsme_project_milestones")
}

// =============================================================================
// TAGS — replaces Project.tags and Post.hashtags JSON arrays
// =============================================================================

model Tag {
  id        String    @id @default(uuid())
  companyId String
  name      String
  colorHex  String?   @db.VarChar(7)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  deletedBy String?

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projects ProjectTag[]
  posts    PostTag[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([deletedAt])
  @@map("itsme_tags")
}

model ProjectTag {
  projectId String
  tagId     String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@index([tagId])
  @@map("itsme_project_tags")
}

model PostTag {
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("itsme_post_tags")
}

// =============================================================================
// TASKS
// =============================================================================

model Task {
  id             String       @id @default(uuid())
  companyId      String
  projectId      String
  workspaceId    String?
  milestoneId    String?
  postId         String?
  parentTaskId   String?
  createdById    String
  assigneeId     String?
  title          String
  description    String?      @db.Text
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?    @db.Date
  estimatedHours Decimal?     @db.Decimal(6, 2)
  showToClient   Boolean      @default(false)
  clientLabel    String?
  position       Int          @default(0)
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  deletedBy      String?
  // loggedHours REMOVED — derive: SUM(TaskTimeLog.durationMinutes)

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspace  Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  milestone  ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  post       Post?             @relation(fields: [postId], references: [id], onDelete: SetNull)
  parentTask Task?             @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subTasks   Task[]            @relation("SubTasks")
  createdBy  User              @relation("TaskCreator", fields: [createdById], references: [id])
  assignee   User?             @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  timeLogs    TaskTimeLog[]
  comments    TaskComment[]
  attachments TaskAttachment[]

  @@index([companyId])
  @@index([projectId])
  @@index([workspaceId])
  @@index([milestoneId])
  @@index([postId])
  @@index([createdById])
  @@index([assigneeId])
  @@index([status])
  @@index([parentTaskId])
  @@index([deletedAt])
  @@map("itsme_tasks")
}

model TaskTimeLog {
  id              String    @id @default(uuid())
  taskId          String
  userId          String
  note            String?   @db.Text
  startedAt       DateTime
  endedAt         DateTime?
  durationMinutes Int? // persisted on clock-out; the aggregation source of truth
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?
  deletedBy       String?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@index([userId])
  @@index([startedAt])
  @@index([deletedAt])
  @@map("itsme_task_time_logs")
}

model TaskComment {
  id         String    @id @default(uuid())
  taskId     String
  userId     String
  parentId   String?
  content    String    @db.Text
  isInternal Boolean   @default(true)
  editedAt   DateTime?
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  deletedBy  String?

  task    Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id])
  parent  TaskComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies TaskComment[] @relation("CommentReplies")

  attachments TaskCommentAttachment[]

  @@index([taskId])
  @@index([userId])
  @@index([parentId])
  @@index([deletedAt])
  @@map("itsme_task_comments")
}

// Join table — file metadata lives on File, never duplicated here.
model TaskAttachment {
  taskId    String
  fileId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([taskId, fileId])
  @@index([fileId])
  @@map("itsme_task_attachments")
}

model TaskCommentAttachment {
  commentId String
  fileId    String
  createdAt DateTime @default(now())

  comment TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  file    File        @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([commentId, fileId])
  @@index([fileId])
  @@map("itsme_task_comment_attachments")
}

// =============================================================================
// POSTS (CONTENT)
// Media, references, per-platform targets and hashtags are all normalised
// out of the parent row.
// =============================================================================

model Post {
  id              String           @id @default(uuid())
  companyId       String
  clientId        String
  projectId       String?
  workspaceId     String?
  campaignId      String?
  createdById     String
  assigneeId      String?
  title           String
  caption         String?          @db.Text
  postType        PostType         @default(STATIC)
  status          PostStatus       @default(IDEA)
  deliverableType DeliverableType?
  scheduledDate   DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  deletedBy       String?
  // platforms JSON  REMOVED — derive from PostTarget rows
  // mediaUrls JSON  REMOVED — see PostMedia
  // references JSON REMOVED — see PostReference
  // hashtags JSON   REMOVED — see PostTag
  // countsAsExtra   REMOVED — derive from ClientPackageUsage
  // publishedAt     REMOVED — per-platform, lives on PostTarget

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  campaign  Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdBy User       @relation("PostCreator", fields: [createdById], references: [id])
  assignee  User?      @relation("PostAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  media          PostMedia[]
  references     PostReference[]
  targets        PostTarget[]
  tags           PostTag[]
  timeline       PostTimelineActivity[]
  tasks          Task[]
  calendarEvents ClientCalendarEvent[]

  @@index([companyId])
  @@index([clientId])
  @@index([projectId])
  @@index([workspaceId])
  @@index([campaignId])
  @@index([createdById])
  @@index([assigneeId])
  @@index([status])
  @@index([scheduledDate])
  @@index([deletedAt])
  @@map("itsme_posts")
}

model PostMedia {
  id        String    @id @default(uuid())
  postId    String
  fileId    String
  mediaType MediaType @default(IMAGE)
  position  Int       @default(0)
  altText   String?
  createdAt DateTime  @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([postId, fileId])
  @@index([postId])
  @@index([fileId])
  @@map("itsme_post_media")
}

model PostReference {
  id        String   @id @default(uuid())
  postId    String
  url       String   @db.Text
  title     String?
  note      String?  @db.Text
  position  Int      @default(0)
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("itsme_post_references")
}

// One row per platform the post publishes to.
// Replaces the old ScheduledPost table, which duplicated caption/media/hashtags.
model PostTarget {
  id              String        @id @default(uuid())
  postId          String
  socialAccountId String
  status          PublishStatus @default(PENDING)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  platformPostId  String?
  failureReason   String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  post          Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([postId, socialAccountId])
  @@index([postId])
  @@index([socialAccountId])
  @@index([status])
  @@index([scheduledAt])
  @@map("itsme_post_targets")
}

model PostTimelineActivity {
  id        String             @id @default(uuid())
  postId    String
  userId    String?
  action    PostTimelineAction
  note      String?            @db.Text
  fromValue String?
  toValue   String?
  createdAt DateTime           @default(now())

  post Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt])
  @@index([userId])
  @@map("itsme_post_timeline_activities")
}

// =============================================================================
// PACKAGES — Gold / Silver / Platinum, reusable inside quotations
// =============================================================================

model Package {
  id           String              @id @default(uuid())
  companyId    String
  createdById  String
  name         String
  description  String?             @db.Text
  price        Decimal             @db.Decimal(14, 2)
  currency     String              @default("INR")
  billingCycle PackageBillingCycle @default(MONTHLY)
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  deletedAt    DateTime?
  deletedBy    String?

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User    @relation("PackageCreator", fields: [createdById], references: [id])

  items          PackageItem[]
  clientPackages ClientPackage[]
  quotationLines QuotationLine[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([createdById])
  @@index([deletedAt])
  @@map("itsme_packages")
}

model PackageItem {
  id              String          @id @default(uuid())
  packageId       String
  deliverableType DeliverableType
  quantity        Int
  note            String?         @db.Text

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, deliverableType])
  @@index([packageId])
  @@map("itsme_package_items")
}

// A package assigned to a client — the subscription instance.
model ClientPackage {
  id            String              @id @default(uuid())
  companyId     String
  clientId      String
  projectId     String?
  packageId     String
  status        ClientPackageStatus @default(ACTIVE)
  priceSnapshot Decimal             @db.Decimal(14, 2)
  startDate     DateTime            @db.Date
  endDate       DateTime?           @db.Date
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?
  deletedBy     String?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  package Package  @relation(fields: [packageId], references: [id])

  usage ClientPackageUsage[]

  @@index([companyId])
  @@index([clientId])
  @@index([projectId])
  @@index([packageId])
  @@index([status])
  @@index([deletedAt])
  @@map("itsme_client_packages")
}

// Allocation vs delivery per deliverable type.
// `extra` REMOVED — derive: GREATEST(deliveredCount - allocatedCount, 0)
model ClientPackageUsage {
  id              String          @id @default(uuid())
  clientPackageId String
  deliverableType DeliverableType
  allocatedCount  Int             @default(0)
  deliveredCount  Int             @default(0)
  updatedAt       DateTime        @updatedAt

  clientPackage ClientPackage @relation(fields: [clientPackageId], references: [id], onDelete: Cascade)

  @@unique([clientPackageId, deliverableType])
  @@index([clientPackageId])
  @@map("itsme_client_package_usage")
}

// =============================================================================
// CAMPAIGNS
// =============================================================================

model Campaign {
  id          String            @id @default(uuid())
  companyId   String
  clientId    String
  projectId   String?
  quotationId String?           @unique
  createdById String
  name        String
  description String?           @db.Text
  objective   CampaignObjective @default(AWARENESS)
  status      CampaignStatus    @default(DRAFT)
  budget      Decimal?          @db.Decimal(14, 2)
  currency    String            @default("INR")
  startDate   DateTime?         @db.Date
  endDate     DateTime?         @db.Date
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  deletedBy   String?
  // platforms JSON REMOVED — derive from linked Posts -> PostTargets
  // spend          REMOVED — derive: SUM(CampaignMetric.spend)

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  quotation Quotation? @relation("CampaignQuotation", fields: [quotationId], references: [id], onDelete: SetNull)
  createdBy User       @relation("CampaignCreator", fields: [createdById], references: [id])

  posts   Post[]
  lists   List[]
  metrics CampaignMetric[]

  @@index([companyId])
  @@index([clientId])
  @@index([projectId])
  @@index([createdById])
  @@index([status])
  @@index([deletedAt])
  @@map("itsme_campaigns")
}

// =============================================================================
// LISTS — influencers, vendors, leads, custom
// =============================================================================

model List {
  id          String    @id @default(uuid())
  companyId   String
  clientId    String?
  projectId   String?
  campaignId  String?
  createdById String
  name        String
  description String?   @db.Text
  listType    ListType  @default(CUSTOM)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedBy   String?

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  campaign  Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdBy User      @relation("ListCreator", fields: [createdById], references: [id])

  items ListItem[]

  @@index([companyId])
  @@index([clientId])
  @@index([projectId])
  @@index([campaignId])
  @@index([createdById])
  @@index([deletedAt])
  @@map("itsme_lists")
}

model ListItem {
  id       String          @id @default(uuid())
  listId   String
  name     String
  email    String?
  phone    String?
  handle   String? // e.g. @username for influencers
  platform SocialPlatform?
  url      String?         @db.Text
  // Genuinely schemaless per-type extras (followers, rate card, niche…).
  // Kept as JSON by design: the attribute set differs per ListType.
  attributes Json?
  note       String?   @db.Text
  position   Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  deletedBy  String?

  list List @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([listId])
  @@index([deletedAt])
  @@map("itsme_list_items")
}

// =============================================================================
// HR — ATTENDANCE & LEAVE (no payroll)
// =============================================================================

model OfficeLocation {
  id           String    @id @default(uuid())
  companyId    String
  addressId    String?
  name         String
  latitude     Decimal   @db.Decimal(10, 7)
  longitude    Decimal   @db.Decimal(10, 7)
  radiusMeters Int       @default(200)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  deletedBy    String?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  address Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  @@unique([companyId, name])
  @@index([companyId])
  @@index([addressId])
  @@index([deletedAt])
  @@map("itsme_office_locations")
}

model AttendanceRecord {
  id           String           @id @default(uuid())
  userId       String
  approvedById String?
  workDate     DateTime         @db.Date
  clockInAt    DateTime?
  clockOutAt   DateTime?
  clockInLat   Decimal?         @db.Decimal(10, 7)
  clockInLng   Decimal?         @db.Decimal(10, 7)
  clockOutLat  Decimal?         @db.Decimal(10, 7)
  clockOutLng  Decimal?         @db.Decimal(10, 7)
  status       AttendanceStatus @default(PRESENT)
  isRemote     Boolean          @default(false)
  note         String?          @db.Text
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?
  deletedBy    String?
  // workingMinutes  REMOVED — derive: clockOutAt - clockInAt
  // overtimeMinutes REMOVED — derive against the shift policy

  user       User  @relation("AttendanceEmployee", fields: [userId], references: [id])
  approvedBy User? @relation("AttendanceApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@unique([userId, workDate])
  @@index([userId])
  @@index([approvedById])
  @@index([workDate])
  @@index([status])
  @@index([deletedAt])
  @@map("itsme_attendance_records")
}

model Holiday {
  id          String    @id @default(uuid())
  companyId   String
  name        String
  holidayDate DateTime  @db.Date
  isOptional  Boolean   @default(false)
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  deletedBy   String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, holidayDate, name])
  @@index([companyId])
  @@index([holidayDate])
  @@index([deletedAt])
  @@map("itsme_holidays")
}

// Company-configurable leave types — replaces the hardcoded LeaveType enum.
model LeaveType {
  id          String    @id @default(uuid())
  companyId   String
  name        String // e.g. "Annual Leave"
  code        String // e.g. "ANNUAL"
  isPaid      Boolean   @default(true)
  defaultDays Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedBy   String?

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  balances LeaveBalance[]
  requests LeaveRequest[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([deletedAt])
  @@map("itsme_leave_types")
}

// Replaces the four hardcoded leave-balance columns on User.
// Per user, per leave type, per year — supports carry-forward and audits.
model LeaveBalance {
  id            String   @id @default(uuid())
  userId        String
  leaveTypeId   String
  year          Int
  allocatedDays Decimal  @default(0) @db.Decimal(5, 1)
  usedDays      Decimal  @default(0) @db.Decimal(5, 1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([userId, leaveTypeId, year])
  @@index([userId])
  @@index([leaveTypeId])
  @@map("itsme_leave_balances")
}

model LeaveRequest {
  id           String      @id @default(uuid())
  userId       String
  leaveTypeId  String
  approverId   String?
  status       LeaveStatus @default(PENDING)
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  totalDays    Decimal     @db.Decimal(4, 1)
  reason       String?     @db.Text
  decisionNote String?     @db.Text
  decidedAt    DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?
  deletedBy    String?
  // appliedAt REMOVED — identical to createdAt

  employee  User      @relation("LeaveEmployee", fields: [userId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
  approver  User?     @relation("LeaveApprover", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([leaveTypeId])
  @@index([approverId])
  @@index([status])
  @@index([startDate])
  @@index([deletedAt])
  @@map("itsme_leave_requests")
}

// =============================================================================
// FINANCE — QUOTATIONS
// Monetary snapshots (totalAmount) are intentionally stored: they are legal
// document values and must never shift if rates change later.
// =============================================================================

model Quotation {
  id              String          @id @default(uuid())
  companyId       String
  clientId        String
  projectId       String?
  createdById     String
  quotationNumber String          @unique
  title           String
  description     String?         @db.Text
  status          QuotationStatus @default(DRAFT)
  currency        String          @default("INR")
  subTotal        Decimal         @db.Decimal(14, 2)
  discountPercent Decimal         @default(0) @db.Decimal(5, 2)
  taxPercent      Decimal         @default(18) @db.Decimal(5, 2)
  totalAmount     Decimal         @db.Decimal(14, 2)
  validUntil      DateTime        @db.Date
  terms           String?         @db.Text
  note            String?         @db.Text
  portalVisible   Boolean         @default(false)
  pdfFileKey      String?
  sentAt          DateTime?
  convertedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  deletedBy       String?
  // discountAmount / taxAmount REMOVED — derive from subTotal and the percents

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client    Client   @relation(fields: [clientId], references: [id])
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User     @relation("QuotationCreator", fields: [createdById], references: [id])

  lineItems QuotationLine[]
  invoice   Invoice?
  campaign  Campaign?       @relation("CampaignQuotation")

  @@index([companyId])
  @@index([clientId])
  @@index([projectId])
  @@index([createdById])
  @@index([status])
  @@index([deletedAt])
  @@map("itsme_quotations")
}

model QuotationLine {
  id          String  @id @default(uuid())
  quotationId String
  packageId   String? // set when the line was inserted from a Package
  description String  @db.Text
  quantity    Decimal @db.Decimal(10, 2)
  unit        String?
  unitPrice   Decimal @db.Decimal(14, 2)
  position    Int     @default(0)
  // totalPrice REMOVED — derive: quantity * unitPrice

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  package   Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@index([packageId])
  @@map("itsme_quotation_lines")
}

// =============================================================================
// FINANCE — INVOICES & PAYMENTS
// =============================================================================

model Invoice {
  id              String        @id @default(uuid())
  companyId       String
  clientId        String
  projectId       String?
  quotationId     String?       @unique
  createdById     String
  invoiceNumber   String        @unique
  title           String
  status          InvoiceStatus @default(DRAFT)
  currency        String        @default("INR")
  subTotal        Decimal       @db.Decimal(14, 2)
  discountPercent Decimal       @default(0) @db.Decimal(5, 2)
  taxPercent      Decimal       @default(18) @db.Decimal(5, 2)
  totalAmount     Decimal       @db.Decimal(14, 2)
  issueDate       DateTime      @db.Date
  dueDate         DateTime      @db.Date
  terms           String?       @db.Text
  note            String?       @db.Text
  portalVisible   Boolean       @default(true)
  pdfFileKey      String?
  sentAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  deletedBy       String?
  // paidAmount / paidAt REMOVED — derive: SUM(Payment.amount), MAX(Payment.paidAt)
  // overdueNotifiedAt REMOVED — the Notification rows are the record

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client    Client     @relation(fields: [clientId], references: [id])
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  quotation Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  createdBy User       @relation("InvoiceCreator", fields: [createdById], references: [id])

  lineItems InvoiceLine[]
  payments  Payment[]

  @@index([companyId])
  @@index([clientId])
  @@index([projectId])
  @@index([createdById])
  @@index([status])
  @@index([dueDate])
  @@index([deletedAt])
  @@map("itsme_invoices")
}

model InvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String
  description String  @db.Text
  quantity    Decimal @db.Decimal(10, 2)
  unit        String?
  unitPrice   Decimal @db.Decimal(14, 2)
  position    Int     @default(0)
  // totalPrice REMOVED — derive: quantity * unitPrice

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("itsme_invoice_lines")
}

model Payment {
  id             String        @id @default(uuid())
  invoiceId      String
  recordedById   String
  amount         Decimal       @db.Decimal(14, 2)
  currency       String        @default("INR")
  method         PaymentMethod
  transactionRef String?
  gatewayName    String?
  gatewayPayload Json? // raw webhook body — schemaless by nature, kept as JSON
  note           String?       @db.Text
  paidAt         DateTime
  createdAt      DateTime      @default(now())
  deletedAt      DateTime?
  deletedBy      String?

  invoice    Invoice @relation(fields: [invoiceId], references: [id])
  recordedBy User    @relation("PaymentRecorder", fields: [recordedById], references: [id])

  @@index([invoiceId])
  @@index([recordedById])
  @@index([paidAt])
  @@index([deletedAt])
  @@map("itsme_payments")
}

// =============================================================================
// FINANCE — EXPENSES
// =============================================================================

model Expense {
  id            String        @id @default(uuid())
  companyId     String
  projectId     String?
  submittedById String
  approvedById  String?
  receiptFileId String?
  category      String
  description   String        @db.Text
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("INR")
  status        ExpenseStatus @default(PENDING)
  decisionNote  String?       @db.Text
  incurredAt    DateTime      @db.Date
  reimbursedAt  DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  deletedBy     String?

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  submittedBy User     @relation("ExpenseSubmitter", fields: [submittedById], references: [id])
  approvedBy  User?    @relation("ExpenseApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  receiptFile File?    @relation(fields: [receiptFileId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([projectId])
  @@index([submittedById])
  @@index([approvedById])
  @@index([receiptFileId])
  @@index([status])
  @@index([deletedAt])
  @@map("itsme_expenses")
}

// =============================================================================
// CHAT — realtime, company-scoped, independent of workspaces
// =============================================================================

model ChatConversation {
  id          String    @id @default(uuid())
  companyId   String
  createdById String
  chatType    ChatType
  name        String? // group name; null for DIRECT
  avatarUrl   String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedBy   String?

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User    @relation("ChatCreator", fields: [createdById], references: [id])

  participants ChatParticipant[]
  messages     ChatMessage[]

  @@index([companyId])
  @@index([createdById])
  @@index([chatType])
  @@index([deletedAt])
  @@map("itsme_chat_conversations")
}

model ChatParticipant {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  isGroupAdmin   Boolean   @default(false)
  lastReadAt     DateTime?
  mutedUntil     DateTime?
  joinedAt       DateTime  @default(now())
  leftAt         DateTime?

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@map("itsme_chat_participants")
}

model ChatMessage {
  id             String          @id @default(uuid())
  conversationId String
  senderId       String
  fileId         String?
  replyToId      String?
  messageType    ChatMessageType @default(TEXT)
  content        String?         @db.Text
  editedAt       DateTime?
  createdAt      DateTime        @default(now())
  deletedAt      DateTime?
  deletedBy      String?
  // attachmentUrl / attachmentName REMOVED — see fileId -> File
  // isEdited / isDeleted REMOVED — derive from editedAt / deletedAt

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation(fields: [senderId], references: [id])
  file         File?            @relation(fields: [fileId], references: [id], onDelete: SetNull)
  replyTo      ChatMessage?     @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      ChatMessage[]    @relation("MessageReplies")

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([fileId])
  @@index([replyToId])
  @@index([deletedAt])
  @@map("itsme_chat_messages")
}

// =============================================================================
// SOCIAL ACCOUNTS & METRICS
// =============================================================================

model SocialAccount {
  id             String         @id @default(uuid())
  companyId      String
  clientId       String
  platform       SocialPlatform
  externalId     String // platform page/profile id
  accountName    String
  accountType    String?
  accessToken    String         @db.Text // AES-256 encrypted at rest
  refreshToken   String?        @db.Text // AES-256 encrypted at rest
  tokenExpiresAt DateTime?
  isActive       Boolean        @default(true)
  lastSyncedAt   DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  deletedBy      String?
  // scopes JSON REMOVED — see SocialAccountScope

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  scopes      SocialAccountScope[]
  postTargets PostTarget[]
  metrics     SocialAccountMetric[]

  @@unique([clientId, platform, externalId])
  @@index([companyId])
  @@index([clientId])
  @@index([tokenExpiresAt])
  @@index([deletedAt])
  @@map("itsme_social_accounts")
}

model SocialAccountScope {
  socialAccountId String
  scope           String

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@id([socialAccountId, scope])
  @@map("itsme_social_account_scopes")
}

// Account-level periodic snapshot.
// engagementRate / costPerClick REMOVED — both are derived ratios.
model SocialAccountMetric {
  id              String   @id @default(uuid())
  socialAccountId String
  periodStart     DateTime @db.Date
  periodEnd       DateTime @db.Date
  reach           Int      @default(0)
  impressions     Int      @default(0)
  engagements     Int      @default(0)
  postsPublished  Int      @default(0)
  followerCount   Int      @default(0)
  followerGrowth  Int      @default(0)
  fetchedAt       DateTime @default(now())

  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([socialAccountId, periodStart, periodEnd])
  @@index([socialAccountId])
  @@index([periodStart])
  @@map("itsme_social_account_metrics")
}

// Campaign-level paid performance — a distinct grain from account metrics.
model CampaignMetric {
  id            String   @id @default(uuid())
  campaignId    String
  periodStart   DateTime @db.Date
  periodEnd     DateTime @db.Date
  spend         Decimal  @default(0) @db.Decimal(14, 2)
  impressions   Int      @default(0)
  clicks        Int      @default(0)
  leads         Int      @default(0)
  leadResponses Int      @default(0)
  conversions   Int      @default(0)
  revenue       Decimal  @default(0) @db.Decimal(14, 2)
  fetchedAt     DateTime @default(now())
  // costPerClick / CTR / ROAS REMOVED — all derived ratios

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, periodStart, periodEnd])
  @@index([campaignId])
  @@index([periodStart])
  @@map("itsme_campaign_metrics")
}

// =============================================================================
// DOCUMENTS — client, project and employee files (metadata lives on File)
// =============================================================================

model Document {
  id              String           @id @default(uuid())
  companyId       String
  fileId          String
  clientId        String?
  projectId       String?
  employeeUserId  String?
  parentId        String? // previous version
  name            String
  description     String?          @db.Text
  category        DocumentCategory @default(OTHER)
  version         Int              @default(1)
  isClientVisible Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  deletedBy       String?
  // uploadedBy / mimeType / fileSize / s3Key REMOVED — all live on File

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  file     File       @relation(fields: [fileId], references: [id])
  client   Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  project  Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  employee User?      @relation("EmployeeDocuments", fields: [employeeUserId], references: [id], onDelete: SetNull)
  parent   Document?  @relation("DocumentVersions", fields: [parentId], references: [id], onDelete: SetNull)
  versions Document[] @relation("DocumentVersions")

  @@index([companyId])
  @@index([fileId])
  @@index([clientId])
  @@index([projectId])
  @@index([employeeUserId])
  @@index([parentId])
  @@index([deletedAt])
  @@map("itsme_documents")
}

// =============================================================================
// NOTIFICATIONS
// =============================================================================

model Notification {
  id                 String              @id @default(uuid())
  userId             String?
  clientPortalUserId String?
  notificationType   NotificationType
  channel            NotificationChannel @default(IN_APP)
  title              String
  body               String              @db.Text
  entity             ActivityEntity?
  entityId           String?
  actionUrl          String?             @db.Text
  readAt             DateTime?
  sentAt             DateTime?
  createdAt          DateTime            @default(now())
  // isRead REMOVED — derive from readAt

  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientPortalUser ClientPortalUser? @relation(fields: [clientPortalUserId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([clientPortalUserId, readAt])
  @@index([createdAt])
  @@map("itsme_notifications")
}

model NotificationPreference {
  id               String           @id @default(uuid())
  userId           String
  notificationType NotificationType
  inApp            Boolean          @default(true)
  email            Boolean          @default(true)
  push             Boolean          @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationType])
  @@index([userId])
  @@map("itsme_notification_preferences")
}

// =============================================================================
// AUDIT TRAIL — append-only, never soft-deleted
// =============================================================================

model ActivityLog {
  id          String         @id @default(uuid())
  userId      String?
  action      ActivityAction
  entity      ActivityEntity
  entityId    String
  summary     String         @db.Text
  beforeState Json?
  afterState  Json?
  ipAddress   String?        @db.VarChar(45)
  userAgent   String?        @db.Text
  createdAt   DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("itsme_activity_logs")
}