# Required: MySQL connection string (Prisma)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Required: generate a unique secret, e.g. `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Public app URLs (use your deployed app URL in production)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
NEXT_PUBLIC_APP_NAME="itsmeDezino Agency"

# Optional: customer share links. Set the domain when using a share subdomain.
# Example: SHARE_DOMAIN="share.example.com"
SHARE_DOMAIN=""
SHARE_BASE_URL=""
NEXT_PUBLIC_SHARE_BASE_URL=""
CONFIRM_DOMAIN=""
CONFIRM_BASE_URL=""
NEXT_PUBLIC_CONFIRM_BASE_URL=""

# Optional SMTP fallback for system emails; per-user SMTP settings may also be used.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
FROM_EMAIL=""

# Keep this stable: changing it prevents decrypting saved SMTP passwords.
SMTP_PASSWORD_ENCRYPTION_KEY="replace-with-a-stable-secret"

# Required for scheduled jobs (EOD todo report, overdue task reminders).
# The cron process sends this as x-cron-secret; the app rejects anything else.
# Generate with: openssl rand -hex 24
# Leave unset and the jobs refuse to run rather than running unauthenticated.
CRON_SECRET=""

# Where the cron process reaches the app. Defaults to http://127.0.0.1:$PORT
CRON_TARGET_URL=""
