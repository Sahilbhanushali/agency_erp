# Required: MySQL connection string (Prisma)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Required: generate a unique secret, e.g. `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Public app URLs (use your deployed app URL in production)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
NEXT_PUBLIC_APP_NAME="itsmeDezino Agency"

# Optional: customer share links. Set the domain when using a share subdomain.
# Example: SHARE_DOMAIN="share.example.com"
SHARE_DOMAIN=""
SHARE_BASE_URL=""
NEXT_PUBLIC_SHARE_BASE_URL=""
CONFIRM_DOMAIN=""
CONFIRM_BASE_URL=""
NEXT_PUBLIC_CONFIRM_BASE_URL=""

# Optional SMTP fallback for system emails; per-user SMTP settings may also be used.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# The address mail is sent from. It must be a real mailbox that the SMTP account above
# is authorised to send as — a display name here breaks the From header and the message
# is treated as forged. Leave empty to send as SMTP_USER.
FROM_EMAIL=""
# The name recipients see, e.g. "itsmeDezino". A name, not an address.
MAIL_FROM_NAME=""

# Keep this stable: changing it prevents decrypting saved SMTP passwords.
SMTP_PASSWORD_ENCRYPTION_KEY="replace-with-a-stable-secret"

# Required for scheduled jobs (EOD todo report, overdue task reminders).
# The cron process sends this as x-cron-secret; the app rejects anything else.
# Generate with: openssl rand -hex 24
# Leave unset and the jobs refuse to run rather than running unauthenticated.
CRON_SECRET=""

# Where the cron process reaches the app. Defaults to http://127.0.0.1:$PORT
CRON_TARGET_URL=""

# ── Instagram integration ────────────────────────────────────────────────────
# Instagram API with Instagram Login (graph.instagram.com). Values come from the
# Meta App Dashboard → your app → Instagram → API setup with Instagram login.
# Placeholders only — never commit real credentials.

# App ID and secret. The secret is server-only: it is used for the token exchange
# and must never be exposed to the browser or prefixed NEXT_PUBLIC_.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Must match a redirect URI registered in the App Dashboard, character for character.
# Falls back to NEXTAUTH_URL + /api/social/instagram/callback when unset.
INSTAGRAM_REDIRECT_URI=https://your-domain.example/api/social/instagram/callback

# Encrypts stored Instagram access tokens (AES-256-GCM). At least 32 characters.
#   openssl rand -hex 32
# Deliberately separate from NEXTAUTH_SECRET: rotating the session secret must not
# destroy stored tokens, because an expired Instagram token cannot be recovered —
# every client would have to authorise again.
INSTAGRAM_TOKEN_KEY=

# Where chat attachments are stored. Must NOT be inside public/ — files there are
# served without any permission check. Defaults to ./storage/chat.
# CHAT_STORAGE_DIR=/var/lib/agency-erp/chat

# Biometric attendance device API. Leave unset to sync by CSV upload only.
ATTENDANCE_API_URL=
ATTENDANCE_API_KEY=
